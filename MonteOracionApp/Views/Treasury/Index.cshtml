@model List<MonteOracionApp.Modules.Treasury.FundBalance>
@{ViewData["Title"]="Tesorería";}
<div class="section-heading"><div><div class="eyebrow">TESORERÍA</div><h1>Fondos y disponibilidad</h1></div><a class="btn btn-primary" asp-action="Create">Solicitar gasto / anticipo</a></div>
<div class="d-flex flex-wrap gap-2 mb-3"><a class="btn btn-outline-primary" asp-action="Requests">Solicitudes (@ViewBag.Pending pendientes)</a><a class="btn btn-outline-primary" asp-action="Closings">Cierres de caja</a><a class="btn btn-outline-primary" asp-controller="Reports" asp-action="Index">Reportes PDF</a></div>
@if((int)ViewBag.Overdue>0){<div class="alert alert-warning">Hay @ViewBag.Overdue anticipos con rendición vencida.</div>}
<div class="panel table-responsive"><table class="table"><thead><tr><th>Fondo</th><th>Medio</th><th>Saldo real registrado</th><th>Reservado</th><th>Disponible</th></tr></thead><tbody>@foreach(var b in Model){<tr><td>@b.Fund.Name<br /><small>@b.Fund.Purpose</small></td><td>@b.Channel</td><td>S/ @b.Balance.ToString("N2")</td><td>S/ @b.Reserved.ToString("N2")</td><td>S/ @((b.Balance-b.Reserved).ToString("N2"))</td></tr>}</tbody></table></div>
@if(User.IsInRole(Roles.Administrator)){<details class="panel mt-3"><summary>Crear fondo con destino específico</summary><form method="post" asp-action="Fund"><label>Nombre</label><input name="Name" required maxlength="120" class="form-control" /><label>Finalidad y restricciones</label><textarea name="Purpose" required maxlength="500" class="form-control"></textarea><button class="btn btn-primary mt-2">Crear fondo</button></form></details>}
