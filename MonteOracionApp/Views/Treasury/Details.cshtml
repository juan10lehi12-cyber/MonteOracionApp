@model MonteOracionApp.Modules.Treasury.FinanceRequest
@using MonteOracionApp.Modules.Treasury
@{ViewData["Title"]="Dinero #"+Model.Id;var finance=User.IsInRole(Roles.Administrator)||User.IsInRole(Roles.Treasurer);var names=(Dictionary<string,string>)ViewBag.Names;}
<div class="section-heading"><h1>Solicitud #@Model.Id · @Model.Status</h1><a asp-action="Requests">Volver</a></div>
<div class="panel mb-3"><h2>S/ @Model.Amount.ToString("N2") · @Model.Kind</h2><p>@Model.Fund.Name · @Model.Channel · @Model.Payee</p><p class="preserve-lines">@Model.Purpose</p><p>Solicita: @names.GetValueOrDefault(Model.RequestedBy,Model.RequestedBy)</p><p>Autoriza: @(Model.ApprovedBy==null?"Pendiente":names.GetValueOrDefault(Model.ApprovedBy,Model.ApprovedBy))</p><p>@Model.DecisionReason</p>@if(Model.DueOn.HasValue){<p>Rendir hasta @Model.DueOn.Value.ToString("dd/MM/yyyy")</p>}
@if(User.IsInRole(Roles.Administrator)&&Model.Status==FinanceStatus.Pendiente){<form method="post" asp-action="Decide" asp-route-id="@Model.Id"><label>Motivo (obligatorio al rechazar)</label><input name="reason" maxlength="1000" class="form-control mb-2" /><button class="btn btn-primary" name="approve" value="true">Aprobar</button> <button class="btn btn-outline-danger" name="approve" value="false">Rechazar</button></form>}
@if(Model.Status is FinanceStatus.Pendiente or FinanceStatus.Aprobada){<form method="post" asp-action="Cancel" asp-route-id="@Model.Id" class="mt-3"><label>Motivo de cancelación</label><input name="reason" required maxlength="1000" class="form-control" /><button class="btn btn-outline-secondary mt-2">Cancelar solicitud</button></form>}
</div>
@if(finance&&Model.Status==FinanceStatus.Aprobada){<form method="post" asp-action="Pay" asp-route-id="@Model.Id" enctype="multipart/form-data" class="panel mb-3" data-confirm="¿Confirmas que el movimiento de dinero ocurrió realmente?"><h2>Confirmar movimiento real</h2><label>Comprobante / constancia JPG, PNG o PDF</label><input name="evidence" type="file" accept=".jpg,.jpeg,.png,.pdf" required class="form-control" /><button class="btn btn-primary mt-3">Registrar operación realizada</button></form>}
@if(finance&&Model.Kind==FinanceKind.Anticipo&&Model.Status==FinanceStatus.Pagada){<form method="post" asp-action="Settle" asp-route-id="@Model.Id" enctype="multipart/form-data" class="panel mb-3" data-confirm="¿Confirmas la revisión de comprobantes y recepción del saldo sobrante?"><h2>Rendir anticipo</h2><label>Gasto real sustentado (S/)</label><input name="spent" type="number" min="0" max="@Model.Amount" step="0.01" required class="form-control" /><label>Comprobantes y constancia de devolución del sobrante</label><input name="evidence" type="file" required accept=".jpg,.jpeg,.png,.pdf" class="form-control" /><button class="btn btn-primary mt-3">Confirmar rendición y devolución recibida</button></form>}
@if(Model.ActualSpent.HasValue){<div class="alert alert-success">Rendido: S/ @Model.ActualSpent.Value.ToString("N2") · devolución: S/ @((Model.Amount-Model.ActualSpent.Value).ToString("N2"))</div>}
@if(finance&&Model.EvidenceKey!=null){<a class="btn btn-outline-primary mb-3" asp-action="Evidence" asp-route-id="@Model.Id">Comprobante de operación</a>}
@if(finance&&Model.SettlementKey!=null){<a class="btn btn-outline-primary mb-3" asp-action="Evidence" asp-route-id="@Model.Id" asp-route-settlement="true">Comprobante de rendición</a>}
<div class="panel"><h2>Movimientos reales</h2>@foreach(var m in (List<MoneyMovement>)ViewBag.Movements){<div class="decision">@m.BusinessDate.ToString("dd/MM/yyyy") · @m.Kind · S/ @m.Amount.ToString("N2") · @names.GetValueOrDefault(m.ActorId,m.ActorId)<p>@m.Detail</p></div>}</div>
