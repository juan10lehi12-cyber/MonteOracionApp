@model MonteOracionApp.Modules.Treasury.FinanceForm
@using MonteOracionApp.Modules.Treasury
@{ViewData["Title"]="Solicitud de dinero";}
<section class="panel form-panel"><h1>Solicitud de dinero</h1><p>La aprobación reserva recursos. El saldo real cambia cuando tesorería confirma la operación.</p><form method="post"><div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="FundId"></label><select asp-for="FundId" class="form-select">@foreach(var f in (List<Fund>)ViewBag.Funds){<option value="@f.Id">@f.Name · @f.Purpose</option>}</select></div><div class="col-md-6"><label asp-for="Channel"></label><select asp-for="Channel" asp-items="Html.GetEnumSelectList<MoneyChannel>()" class="form-select"></select></div>
<div class="col-md-6"><label asp-for="Kind"></label><select asp-for="Kind" class="form-select">@foreach(var k in Enum.GetValues<FinanceKind>()){if(User.IsInRole(Roles.Administrator)||k is FinanceKind.Gasto or FinanceKind.Anticipo){<option value="@k">@k</option>}}</select></div><div class="col-md-6"><label asp-for="Amount"></label><input asp-for="Amount" type="number" min="0.01" step="0.01" class="form-control" /></div></div>
<div class="my-3"><label asp-for="Purpose"></label><textarea asp-for="Purpose" class="form-control" rows="3"></textarea></div><div class="mb-3"><label asp-for="Payee"></label><input asp-for="Payee" class="form-control" /></div><div class="mb-3"><label asp-for="DueOn"></label><input asp-for="DueOn" class="form-control" /></div><button class="btn btn-primary">Enviar a aprobación</button></form></section>
