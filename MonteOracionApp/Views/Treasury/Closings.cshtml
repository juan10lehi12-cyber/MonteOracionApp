@model List<MonteOracionApp.Modules.Treasury.CashClosing>
@{ViewData["Title"]="Cierres de caja";}
<h1>Caja y conciliación digital</h1><p>Compara el efectivo registrado con el conteo físico. El cierre bloquea esa fecha y las anteriores; las diferencias se corrigen mediante una solicitud de ajuste en fecha abierta.</p>
<form method="post" asp-action="Close" enctype="multipart/form-data" class="panel mb-4" data-confirm="¿Confirmas el cierre? Los movimientos hasta esta fecha quedarán bloqueados."><label>Medio a conciliar</label><select name="channel" class="form-select mb-3"><option value="Efectivo">Efectivo contado</option><option value="Digital">Digital: saldo agregado de cuentas y billeteras</option></select><label>Estado de cuenta / constancia (obligatorio para digital)</label><input name="evidence" type="file" accept=".jpg,.jpeg,.png,.pdf" class="form-control mb-3" /><div class="row g-3"><div class="col-md-4"><label>Fecha</label><input name="day" type="date" value="@ChurchTime.Today.ToString("yyyy-MM-dd")" max="@ChurchTime.Today.ToString("yyyy-MM-dd")" required class="form-control" /></div><div class="col-md-4"><label>Saldo real contado / verificado (S/)</label><input name="counted" type="number" min="0" step="0.01" required class="form-control" /></div><div class="col-md-4"><label>Observaciones de diferencias</label><input name="notes" maxlength="1000" class="form-control" /></div></div><button class="btn btn-primary mt-3">Confirmar cierre</button></form>
@foreach(var c in Model){<article class="panel mb-3"><h2>@c.Channel · Cierre #@c.Id · @c.Day.ToString("dd/MM/yyyy")</h2><p>Saldo previo: S/ @c.Opening.ToString("N2") · ingresos: S/ @c.Income.ToString("N2") · salidas: S/ @c.Outgoing.ToString("N2")</p><p>Esperado: S/ @c.Expected.ToString("N2") · contado: S/ @c.Counted.ToString("N2") · <strong>Diferencia: S/ @((c.Counted-c.Expected).ToString("N2"))</strong></p><p>@c.Notes</p><p>@(c.ReviewedBy==null?"Pendiente de revisión":"Revisado por administración")</p><a class="btn btn-outline-primary" asp-controller="Reports" asp-action="Download" asp-route-kind="cierre" asp-route-id="@c.Id">Descargar PDF</a>@if(c.EvidenceKey!=null){<a class="btn btn-outline-secondary" asp-action="ClosingEvidence" asp-route-id="@c.Id">Estado / constancia</a>}@if(User.IsInRole(Roles.Administrator)&&c.ReviewedBy==null){<form method="post" asp-action="Review" asp-route-id="@c.Id" class="d-inline"><button class="btn btn-primary">Marcar revisado</button></form>}</article>}
