@model List<Publication>
@{ ViewData["Title"] = "Nuestra comunidad"; var church = (ChurchSettings)ViewBag.Church; var payments = (List<PaymentMethod>)ViewBag.PaymentMethods; }
<section class="hero">
    <div class="eyebrow">BIENVENIDOS A NUESTRA COMUNIDAD</div>
    <h1>@church.Name</h1>
    <p class="preserve-lines">@church.About</p>
    <a class="btn btn-light" href="#donar">Ver medios para donar</a>
    <a class="hero-link" href="#publicaciones">Eventos y avisos ↓</a>
</section>
<div class="contact-strip"><span>@church.Address</span><span>@church.Contact</span></div>
<section class="donation-section" id="donar">
    <div class="section-heading"><div><div class="eyebrow">APOYA A NUESTRA COMUNIDAD</div><h2>Medios para donar</h2><p>Escanea el QR o usa los datos publicados. Luego registra tu donación y adjunta el comprobante para que la administración la revise.</p></div></div>
    @if (payments.Count == 0) {
        <div class="empty-state">La iglesia publicará aquí sus medios de pago disponibles.</div>
    } else {
        <div class="row g-3">
        @foreach (var payment in payments) {
            <div class="col-md-6 col-xl-4"><article class="panel payment-card h-100">
                <div class="eyebrow">MEDIO DE DONACIÓN</div>
                <h3 class="mt-2">@payment.Name</h3>
                <p class="preserve-lines">@payment.Instructions</p>
                @if (payment.QrStorageKey != null) {
                    <a href="@Url.Action("Qr", "Settings", new { id = payment.Id })" target="_blank" rel="noopener" aria-label="Ampliar QR de @payment.Name">
                        <img src="@Url.Action("Qr", "Settings", new { id = payment.Id })" alt="Código QR para donar por @payment.Name" class="payment-qr" loading="lazy" />
                    </a>
                }
            </article></div>
        }
        </div>
        <div class="donation-next-step"><p>Cuando termines el pago, adjunta una foto de tu comprobante. La donación quedará pendiente hasta que la iglesia confirme la recepción.</p><a class="btn btn-primary" asp-controller="Donations" asp-action="Create">Registrar mi donación</a></div>
    }
</section>
<div class="section-heading" id="publicaciones"><div><div class="eyebrow">VIDA EN COMUNIDAD</div><h2>Eventos e información</h2></div></div>
@if (Model.Count == 0) { <div class="empty-state">Pronto compartiremos nuestros próximos eventos y avisos.</div> }
<div class="row g-4">
@foreach (var p in Model) {
    <div class="col-md-6"><article class="panel h-100">
        <div class="d-flex justify-content-between"><span class="badge text-bg-light">@p.Kind</span>@if(p.IsCancelled) { <span class="badge text-bg-danger">Cancelado</span> }</div>
        <h3 class="mt-3">@p.Title</h3>
        @if (p.EventAt.HasValue) { <p class="text-secondary">@p.EventAt.Value.ToString("dd/MM/yyyy HH:mm") · @p.Location</p> }
        <p class="preserve-lines">@p.Body</p>
    </article></div>
}
</div>
<partial name="_Pagination" />
