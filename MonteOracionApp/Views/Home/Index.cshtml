@model List<Publication>
@{ViewData["Title"]="Nuestra comunidad";var church=(ChurchSettings)ViewBag.Church;var payments=(List<PaymentMethod>)ViewBag.PaymentMethods;}
<section class="hero hero-compact"><div class="eyebrow">GENEROSIDAD Y COMUNIDAD</div><h1>@church.Name</h1><div class="d-flex flex-wrap gap-2"><a class="btn btn-light" href="#donar">Donar</a><a class="btn btn-outline-light" asp-controller="Portal" asp-action="Index">Consultar mis donaciones</a><a class="btn btn-outline-light" href="#publicaciones">Ver eventos</a></div></section>
<section class="donation-section" id="donar"><div class="section-heading"><div><div class="eyebrow">APOYA A NUESTRA COMUNIDAD</div><h2>Medios para donar</h2><p>Realiza tu pago y registra el comprobante para su verificación.</p></div><a class="btn btn-primary" asp-controller="Donations" asp-action="Create">Registrar donación</a></div>
@if(payments.Count==0){<div class="empty-state">La iglesia publicará aquí los medios de pago disponibles.</div>}else{<div class="row g-3">@foreach(var payment in payments){<div class="col-md-6 col-xl-4"><article class="panel payment-card h-100"><h3>@payment.Name</h3><p class="preserve-lines">@payment.Instructions</p>@if(payment.QrStorageKey!=null){<a href="@Url.Action("Qr","Settings",new{id=payment.Id})" target="_blank" rel="noopener"><img class="payment-qr" src="@Url.Action("Qr","Settings",new{id=payment.Id})" alt="Código QR de @payment.Name" /></a>}</article></div>}</div>}
<p class="mt-3 text-secondary">También recibimos alimentos, instrumentos y otros bienes. Coordina la entrega con la iglesia; el personal registrará lo recibido.</p></section>
<section id="publicaciones"><div class="section-heading"><div><div class="eyebrow">VIDA EN COMUNIDAD</div><h2>Eventos e información</h2></div><div class="btn-group"><a class="btn @(ViewBag.Period=="proximos"?"btn-primary":"btn-outline-primary")" asp-action="Index" asp-route-period="proximos" asp-fragment="publicaciones">Próximos</a><a class="btn @(ViewBag.Period=="realizados"?"btn-primary":"btn-outline-primary")" asp-action="Index" asp-route-period="realizados" asp-fragment="publicaciones">Realizados</a></div></div>
@if(Model.Count==0){<div class="empty-state">No hay publicaciones en esta sección.</div>}
<div class="row g-4">@foreach(var p in Model){<div class="col-md-6 col-xl-4"><article class="panel event-card h-100">@if(p.ImageKey!=null){<img class="event-cover" src="@Url.Action("Image","Publications",new{id=p.Id})" alt="@p.Title" loading="lazy" />}<span class="badge text-bg-light">@p.Kind</span>@if(p.IsCancelled){<span class="badge text-bg-danger">Cancelado</span>}<h3 class="mt-3">@p.Title</h3><p>@p.EventAt?.ToString("dd/MM/yyyy HH:mm") · @p.Location</p><button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#event-@p.Id">Ver detalles</button></article></div><partial name="_EventModal" model="p" />}</div>
<div class="d-flex gap-3 my-3">@if((int)ViewBag.Page>1){<a asp-action="Index" asp-route-page="@((int)ViewBag.Page-1)" asp-route-period="@ViewBag.Period" asp-fragment="publicaciones">Anterior</a>}@if((int)ViewBag.Page*12<(int)ViewBag.Total){<a asp-action="Index" asp-route-page="@((int)ViewBag.Page+1)" asp-route-period="@ViewBag.Period" asp-fragment="publicaciones">Siguiente</a>}</div></section>
<section class="panel mt-4"><h2>Conoce nuestra iglesia</h2><p class="preserve-lines">@church.About</p><p>@church.Address · @church.Contact</p></section>
