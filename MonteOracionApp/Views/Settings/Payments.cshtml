@model List<PaymentMethod>
@{ ViewData["Title"] = "Medios de pago"; }
<div class="section-heading"><h1>Medios de pago</h1><a class="btn btn-primary" asp-action="Payment">Agregar medio</a></div>
<div class="row g-3">@foreach(var p in Model) { <div class="col-md-6"><section class="panel"><h2>@p.Name</h2><p>@p.Instructions</p><p>@(p.IsActive ? "Disponible al público" : "Desactivado")</p><a class="btn btn-outline-primary" asp-action="Payment" asp-route-id="@p.Id">Editar</a></section></div> }</div>
@if(Model.Count == 0) { <div class="empty-state">Agrega Yape o una cuenta bancaria para habilitar las donaciones digitales.</div> }
