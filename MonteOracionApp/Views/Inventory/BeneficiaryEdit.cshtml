@model MonteOracionApp.Modules.Inventory.Beneficiary
@{ViewData["Title"]="Editar beneficiario";}
<section class="panel form-panel"><h1>Editar beneficiario</h1><p>Las solicitudes anteriores conservan el nombre y dirección registrados al solicitar.</p><form method="post" asp-route-id="@Model.Id"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Name"></label><input asp-for="Name" class="form-control mb-3" /><label asp-for="Address"></label><input asp-for="Address" class="form-control mb-3" /><label asp-for="Contact"></label><input asp-for="Contact" class="form-control mb-3" /><label asp-for="Phone"></label><input asp-for="Phone" class="form-control mb-3" /><label><input asp-for="IsActive" /> Activo</label><label>Motivo del cambio</label><textarea name="reason" required maxlength="1000" class="form-control mb-3"></textarea><button class="btn btn-primary">Guardar</button></form></section>
