@model List<MonteOracionApp.Modules.Inventory.StockLot>
@{ ViewData["Title"]="Inventario"; }
<div class="section-heading"><div><div class="eyebrow">ALMACÉN</div><h1>Existencias y reservas</h1></div><a class="btn btn-primary" asp-controller="Donations" asp-action="Receive">Registrar recepción</a></div>
@if (ViewBag.PendingCount is int pc && pc > 0)
{<div class="alert alert-warning d-flex justify-content-between align-items-center"><span>Hay <strong>@pc entrada(s) por dar visto bueno</strong>.</span><a class="btn btn-sm btn-warning" asp-action="Pending">Revisar entradas</a></div>}
<div class="d-flex flex-wrap gap-2 mb-4">@if(User.IsInRole(Roles.Administrator)||User.IsInRole(Roles.Warehouse)){<a class="btn btn-sm btn-outline-secondary" asp-action="Products">Catálogo de productos</a>}@if(User.IsInRole(Roles.Administrator)){<a class="btn btn-sm btn-outline-secondary" asp-action="Beneficiaries">Beneficiarios</a>}@if(User.IsInRole(Roles.Administrator)||User.IsInRole(Roles.Warehouse)){<a class="btn btn-sm btn-outline-secondary" asp-action="Legacy">Incorporar bienes anteriores</a>}</div>
<form method="get" class="panel d-flex gap-3 mb-3 flex-wrap"><input name="search" value="@ViewBag.Search" class="form-control w-auto" placeholder="Producto o ubicación" aria-label="Buscar inventario" /><label class="d-flex gap-2 align-items-center"><input type="checkbox" name="availableOnly" value="true" checked="@ViewBag.AvailableOnly" /> Solo disponibles</label><button class="btn btn-primary">Filtrar</button><a asp-action="Index">Limpiar</a></form>
<div class="panel table-responsive"><table class="table"><thead><tr><th>Lote / producto</th><th>Ubicación</th><th>Vence</th><th>Físico</th><th>Reservado</th><th>Disponible</th><th></th></tr></thead><tbody>
@foreach(var l in Model){<tr><td>#@l.Id · @l.Product.Name<br /><small>@l.Product.Unit</small></td><td>@l.Location</td><td>@l.ExpiresOn?.ToString("dd/MM/yyyy") @if(l.ExpiresOn < ChurchTime.Today){<span class="badge text-bg-danger">Vencido</span>}else if(l.ExpiresOn<=ChurchTime.Today.AddDays(30)){<span class="badge text-bg-warning">Próximo a vencer</span>}</td><td>@l.OnHand.ToString("0.##")</td><td>@l.Reserved.ToString("0.##")</td><td>@((l.OnHand-l.Reserved).ToString("0.##"))</td><td><a asp-action="Lot" asp-route-id="@l.Id">Movimientos</a></td></tr>}
</tbody></table>@if(Model.Count==0){<p>No hay existencias para mostrar.</p>}</div>
