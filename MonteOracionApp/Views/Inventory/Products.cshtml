@model List<MonteOracionApp.Modules.Inventory.Product>
@{ ViewData["Title"]="Productos"; }
<h1>Catálogo de productos</h1><p>La unidad se conserva en cada lote. Crea presentaciones diferentes para una lata, una bolsa o un kilogramo.</p>
@if(User.IsInRole(Roles.Administrator)||User.IsInRole(Roles.Warehouse)){
<form method="post" asp-action="Product" class="panel row g-3 mb-4"><div class="col-md-4"><label for="Name">Producto</label><input id="Name" name="Name" maxlength="160" required class="form-control" /></div><div class="col-md-3"><label for="Unit">Unidad</label><input id="Unit" name="Unit" maxlength="40" required class="form-control" placeholder="kg / lata / unidad" /></div><div class="col-md-3"><label for="Category">Categoría</label><input id="Category" name="Category" maxlength="100" required class="form-control" /></div><div class="col-md-2"><label><input type="checkbox" name="RequiresExpiry" value="true" /> Requiere vencimiento</label><button class="btn btn-primary">Crear</button></div></form>}
@if(User.IsInRole(Roles.Administrator)){
<form method="post" asp-action="ProductUnify" class="panel row g-3 mb-4" data-confirm="¿Mover el historial del duplicado al producto correcto y desactivar el duplicado?"><div class="col-md-4"><label for="fromId">Producto duplicado (con historial)</label><select id="fromId" name="fromId" class="form-select"><option value="0">Elegir…</option>@foreach(var p in Model.Where(x=>x.IsActive)){<option value="@p.Id">@p.Name · @p.Unit</option>}</select></div><div class="col-md-4"><label for="toId">Producto correcto</label><select id="toId" name="toId" class="form-select"><option value="0">Elegir…</option>@foreach(var p in Model.Where(x=>x.IsActive)){<option value="@p.Id">@p.Name · @p.Unit</option>}</select></div><div class="col-md-4 d-flex align-items-end"><button class="btn btn-primary">Unificar historial en el correcto</button></div></form>
<p class="small text-secondary mb-3">Si un bien se registró con el nombre mal escrito, mueve sus lotes y donaciones al producto correcto: el duplicado queda desactivado como «(unificado)» y nunca se borra.</p>}
<div class="panel"><table class="table"><thead><tr><th>Producto</th><th>Unidad</th><th>Categoría</th><th>Vencimiento obligatorio</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Name · @(p.IsActive?"Activo":"Inactivo") @if(User.IsInRole(Roles.Administrator)||User.IsInRole(Roles.Warehouse)){<a asp-action="ProductEdit" asp-route-id="@p.Id">Editar</a>}</td><td>@p.Unit</td><td>@p.Category</td><td>@(p.RequiresExpiry?"Sí":"No")</td></tr>}</tbody></table></div>
