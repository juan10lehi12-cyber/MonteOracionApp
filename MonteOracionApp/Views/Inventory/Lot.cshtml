@model MonteOracionApp.Modules.Inventory.StockLot
@using MonteOracionApp.Modules.Inventory
@{ViewData["Title"]="Lote #"+Model.Id;}
<h1>Lote #@Model.Id · @Model.Product.Name</h1><div class="panel mb-3"><p>@Model.Origin · @Model.Location · vence @Model.ExpiresOn?.ToString("dd/MM/yyyy")</p><p>Físico: @Model.OnHand · reservado: @Model.Reserved · disponible: @(Model.OnHand-Model.Reserved) @Model.Product.Unit</p></div>
@if(User.IsInRole(Roles.Administrator)){<form class="panel mb-3" method="post" asp-action="Adjust" asp-route-id="@Model.Id"><input name="commandId" type="hidden" value="@Guid.NewGuid()" /><h2>Ajuste autorizado tras conteo físico</h2><p>Una baja usa cantidad negativa. Las reservas deben liberarse antes de una baja que las afecte.</p><label>Cambio de cantidad</label><input name="change" type="number" step="0.01" required class="form-control" /><label>Motivo y evidencia del conteo</label><textarea name="reason" required maxlength="1000" class="form-control"></textarea><label><input type="checkbox" name="loss" value="true" /> Es una merma / vencimiento</label><button class="btn btn-outline-danger">Registrar ajuste</button></form>}
<div class="panel"><h2>Movimientos</h2>@foreach(var m in (List<StockMovement>)ViewBag.Movements){<div class="decision">@m.At.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm") · @m.Kind · cambio físico @m.Quantity · cambio reserva @m.ReservedChange<p>@m.Reason</p></div>}</div>
