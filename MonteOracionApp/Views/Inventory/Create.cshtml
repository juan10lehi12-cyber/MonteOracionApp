@model MonteOracionApp.Modules.Inventory.StockRequestForm
@using MonteOracionApp.Modules.Inventory
@{ViewData["Title"]="Solicitar bienes";var lots=(List<StockLot>)ViewBag.Lots;var beneficiaries=(List<Beneficiary>)ViewBag.Beneficiaries;}
<section class="panel form-panel"><h1>Solicitar bienes</h1><p>La aprobación reserva existencias. Una persona distinta debe autorizar la solicitud.</p><form method="post"><div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3"><label asp-for="BeneficiaryId"></label><select asp-for="BeneficiaryId" class="form-select"><option value="">Seleccionar</option>@foreach(var b in beneficiaries){<option value="@b.Id">@b.Name · @b.Address</option>}</select></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="Kind"></label><select asp-for="Kind" asp-items="Html.GetEnumSelectList<StockRequestKind>()" class="form-select"></select></div><div class="col-md-6"><label asp-for="Priority"></label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<StockPriority>()" class="form-select"></select></div><div class="col-md-6"><label asp-for="NeededOn"></label><input asp-for="NeededOn" class="form-control" /></div><div class="col-md-6"><label asp-for="ReturnDueOn"></label><input asp-for="ReturnDueOn" class="form-control" /></div></div>
<div class="my-3"><label asp-for="Purpose"></label><textarea asp-for="Purpose" class="form-control" rows="3"></textarea></div>
<h2>Productos y lotes</h2><div data-repeat-container>
@for(var i=0;i<Model.Lines.Count;i++){<div class="row g-2 mb-3" data-repeat-row><div class="col-md-9"><label>Lote (primero vence, primero sale)</label><select asp-for="Lines[i].StockLotId" class="form-select"><option value="">Seleccionar</option>@foreach(var l in lots){<option value="@l.Id">#@l.Id · @l.Product.Name · disponible @((l.OnHand-l.Reserved).ToString("0.##")) @l.Product.Unit · @l.Location · vence @l.ExpiresOn?.ToString("dd/MM/yyyy")</option>}</select></div><div class="col-md-3"><label>Cantidad</label><input asp-for="Lines[i].Quantity" type="number" min="0.01" step="0.01" class="form-control" /></div></div>}
</div><button type="button" data-repeat-add class="btn btn-outline-secondary mb-3">Agregar otro lote</button><div><button class="btn btn-primary">Enviar solicitud</button></div></form></section>
