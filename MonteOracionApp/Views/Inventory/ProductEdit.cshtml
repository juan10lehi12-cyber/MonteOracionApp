@model MonteOracionApp.Modules.Inventory.Product
@{ViewData["Title"]="Editar producto";}
<section class="panel form-panel"><h1>Editar producto</h1><p>Las presentaciones utilizadas conservan nombre, unidad y regla de vencimiento para proteger su historial.</p><form method="post" asp-route-id="@Model.Id"><div asp-validation-summary="All" class="text-danger"></div>
<label asp-for="Name"></label><input asp-for="Name" class="form-control mb-3" /><label asp-for="Unit"></label><input asp-for="Unit" class="form-control mb-3" /><label asp-for="Category"></label><input asp-for="Category" class="form-control mb-3" /><label><input asp-for="RequiresExpiry" /> Requiere vencimiento</label>@if(User.IsInRole(Roles.Administrator)){<label><input asp-for="IsActive" /> Activo</label>}else{<input name="IsActive" type="hidden" value="@Model.IsActive.ToString()" /><p>Estado: @(Model.IsActive?"Activo":"Inactivo")</p>}<label>Motivo del cambio</label><textarea name="reason" required maxlength="1000" class="form-control mb-3"></textarea><button class="btn btn-primary">Guardar</button></form></section>
