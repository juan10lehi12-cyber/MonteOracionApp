@model MonteOracionApp.Modules.Inventory.StockRequest
@using MonteOracionApp.Modules.Inventory
@{ViewData["Title"]="Solicitud #"+Model.Id;var stock=User.IsInRole(Roles.Administrator)||User.IsInRole(Roles.Warehouse);var names=(Dictionary<string,string>)ViewBag.Names;}
<div class="section-heading"><h1>Solicitud #@Model.Id · @Model.Status</h1><a asp-action="Requests">Volver</a></div>
<div class="panel mb-4"><h2>@Model.BeneficiaryName</h2><p>@Model.BeneficiaryAddress · @Model.BeneficiaryContact</p><p>@Model.Kind · @Model.Priority · necesaria @Model.NeededOn.ToString("dd/MM/yyyy")</p><p class="preserve-lines">@Model.Purpose</p><p>Solicita: @names.GetValueOrDefault(Model.RequestedBy,Model.RequestedBy) · Autoriza: @(Model.ApprovedBy==null?"Pendiente":names.GetValueOrDefault(Model.ApprovedBy,Model.ApprovedBy))</p><p>@Model.DecisionReason</p>@if(Model.ReturnDueOn.HasValue){<p>Reposición límite: @Model.ReturnDueOn.Value.ToString("dd/MM/yyyy")</p>}
@if(User.IsInRole(Roles.Administrator)&&Model.Status==StockRequestStatus.Pendiente){<form method="post" asp-action="Decide" asp-route-id="@Model.Id"><label for="decision">Motivo / observaciones (obligatorio al rechazar)</label><input id="decision" name="reason" maxlength="1000" class="form-control mb-2" /><button class="btn btn-primary" name="approve" value="true">Aprobar y reservar</button> <button class="btn btn-outline-danger" name="approve" value="false">Rechazar</button></form>}
@if(Model.Status is StockRequestStatus.Pendiente or StockRequestStatus.Aprobada or StockRequestStatus.Parcial){<form class="mt-3" method="post" asp-action="Cancel" asp-route-id="@Model.Id"><label>Motivo de cancelación</label><input name="reason" required maxlength="1000" class="form-control mb-2" /><button class="btn btn-outline-secondary">Cancelar pendiente y liberar reserva</button></form>}
</div>
@foreach(var line in Model.Lines){<section class="panel mb-3"><h2>@line.StockLot.Product.Name · lote #@line.StockLotId</h2><p>Solicitado: @line.Quantity · entregado: @line.Delivered · repuesto: @line.Returned · condonado: @line.WrittenOff @line.StockLot.Product.Unit</p>
@if(stock && Model.Status is StockRequestStatus.Aprobada or StockRequestStatus.Parcial && line.Delivered<line.Quantity){<form method="post" asp-action="Deliver" asp-route-id="@Model.Id" enctype="multipart/form-data" data-confirm="¿Confirmas la entrega física de estos bienes?"><input name="commandId" type="hidden" value="@Guid.NewGuid()" /><input name="lineId" value="@line.Id" type="hidden" /><div class="row g-2"><div class="col-md-3"><label>Cantidad a entregar</label><input name="quantity" type="number" min="0.01" max="@(line.Quantity-line.Delivered)" step="0.01" required class="form-control" /></div><div class="col-md-4"><label>Nombre de quien recibe</label><input name="receiver" maxlength="160" required class="form-control" /></div><div class="col-md-5"><label>Constancia JPG, PNG o PDF</label><input name="evidence" type="file" accept=".jpg,.jpeg,.png,.pdf" required class="form-control" /></div></div><button class="btn btn-primary mt-2">Registrar entrega</button></form>}
@if(stock && Model.Kind==StockRequestKind.Prestamo && line.Delivered>line.Returned+line.WrittenOff){<form class="mt-3" method="post" asp-action="Return" asp-route-id="@Model.Id"><h3>Reposición físicamente recibida</h3><input name="commandId" type="hidden" value="@Guid.NewGuid()" /><input name="lineId" value="@line.Id" type="hidden" /><div class="row g-2"><div class="col-md-3"><label>Cantidad</label><input name="quantity" type="number" step="0.01" min="0.01" max="@(line.Delivered-line.Returned-line.WrittenOff)" required class="form-control" /></div><div class="col-md-4"><label>Ubicación del nuevo lote</label><input name="location" maxlength="160" required class="form-control" /></div><div class="col-md-5"><label>Vencimiento del producto repuesto</label><input name="expiry" type="date" class="form-control" required="@line.StockLot.Product.RequiresExpiry" /></div></div><label class="mt-2">Condición y observación</label><input name="reason" required maxlength="1000" class="form-control" /><button class="btn btn-primary mt-2">Recibir reposición</button></form>
@if(User.IsInRole(Roles.Administrator)){<details class="mt-3"><summary>Condonar reposición con autorización</summary><form method="post" asp-action="WriteOff" asp-route-id="@Model.Id"><input name="commandId" type="hidden" value="@Guid.NewGuid()" /><input name="lineId" type="hidden" value="@line.Id" /><label>Cantidad que se condona</label><input name="quantity" type="number" min="0.01" step="0.01" required class="form-control" /><label>Motivo</label><input name="reason" required maxlength="1000" class="form-control" /><button class="btn btn-outline-danger mt-2">Autorizar condonación</button></form></details>}}
</section>}
<div class="panel"><h2>Historial</h2>@foreach(var m in (List<StockMovement>)ViewBag.Movements){<div class="decision">@m.At.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm") · @m.Kind · @m.Quantity.ToString("0.##") · @names.GetValueOrDefault(m.ActorId,m.ActorId)<p>@m.Reason @m.Receiver</p>@if(m.EvidenceKey!=null&&stock){<a asp-action="Evidence" asp-route-id="@m.Id">Descargar constancia</a>}</div>}</div>
