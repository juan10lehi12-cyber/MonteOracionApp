@model List<MonteOracionApp.Modules.Inventory.Beneficiary>
@{ViewData["Title"]="Beneficiarios";}
<h1>Beneficiarios y responsables</h1>
@if(User.IsInRole(Roles.Administrator)){<form method="post" asp-action="Beneficiary" class="panel row g-3 mb-4"><div class="col-md-6"><label for="Name">Persona / institución</label><input id="Name" name="Name" required maxlength="160" class="form-control" /></div><div class="col-md-6"><label for="Address">Dirección y distrito</label><input id="Address" name="Address" required maxlength="250" class="form-control" /></div><div class="col-md-6"><label for="Contact">Contacto responsable</label><input id="Contact" name="Contact" required maxlength="160" class="form-control" /></div><div class="col-md-6"><label for="Phone">Teléfono</label><input id="Phone" name="Phone" maxlength="30" class="form-control" /></div><div><button class="btn btn-primary">Registrar beneficiario</button></div></form>}
<div class="panel table-responsive"><table class="table"><thead><tr><th>Nombre</th><th>Dirección</th><th>Contacto</th></tr></thead><tbody>@foreach(var b in Model){<tr><td>@b.Name · @(b.IsActive?"Activo":"Inactivo") @if(User.IsInRole(Roles.Administrator)){<a asp-action="BeneficiaryEdit" asp-route-id="@b.Id">Editar</a>}</td><td>@b.Address</td><td>@b.Contact · @b.Phone</td></tr>}</tbody></table></div>
