@model List<MonteOracionApp.Modules.Inventory.StockRequest>
@using MonteOracionApp.Modules.Inventory
@{ViewData["Title"]="Solicitudes de bienes";}
<div class="section-heading"><h1>Solicitudes de bienes</h1><a class="btn btn-primary" asp-action="Create">Nueva solicitud</a></div>
<form method="get" class="d-flex gap-2 mb-3"><select name="status" class="form-select w-auto" aria-label="Estado"><option value="">Todos los estados</option>@foreach(var s in Enum.GetValues<StockRequestStatus>()){<option value="@s" selected="@(ViewBag.Status != null && (StockRequestStatus)ViewBag.Status==s)">@s</option>}</select><button class="btn btn-outline-primary">Filtrar</button></form>
<div class="panel table-responsive"><table class="table"><thead><tr><th>Número / destino</th><th>Tipo</th><th>Prioridad</th><th>Fecha necesaria</th><th>Estado</th><th>Reposición</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td>#@r.Id · @r.BeneficiaryName</td><td>@r.Kind</td><td>@r.Priority</td><td>@r.NeededOn.ToString("dd/MM/yyyy")</td><td>@r.Status</td><td>@if(r.Kind==StockRequestKind.Prestamo){<span>@r.Lines.Count(x=>x.Delivered>x.Returned+x.WrittenOff) productos con reposición pendiente</span>@if(r.ReturnDueOn<ChurchTime.Today && r.Lines.Any(x=>x.Delivered>x.Returned+x.WrittenOff)){<span class="badge text-bg-danger">Vencido</span>}}</td><td><a asp-action="Details" asp-route-id="@r.Id">Ver solicitud</a></td></tr>}</tbody></table></div>
