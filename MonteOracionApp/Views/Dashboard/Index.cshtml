@{ViewData["Title"]="Panel del personal";var finance=User.IsInRole(Roles.Administrator)||User.IsInRole(Roles.Treasurer);var stock=User.IsInRole(Roles.Administrator)||User.IsInRole(Roles.Warehouse);}
<div class="section-heading"><div><div class="eyebrow">PERSONAL DE LA IGLESIA</div><h1>Hola, @(User.FindFirst("staff_name")?.Value??User.Identity?.Name)</h1><p>Solicitudes, saldos y próximas acciones según tus permisos.</p></div></div>
<div class="row g-3 mb-4">
@if(finance){<div class="col-md-6 col-xl-4"><div class="panel metric"><span>Donaciones por verificar</span><strong>@ViewBag.Pending</strong><a asp-controller="Donations" asp-action="Index" asp-route-status="Pendiente">Revisar registros →</a></div></div><div class="col-md-6 col-xl-4"><div class="panel metric"><span>Anticipos con rendición vencida</span><strong>@ViewBag.Advances</strong><a asp-controller="Treasury" asp-action="Requests">Revisar anticipos →</a></div></div>}
@if(stock){<div class="col-md-6 col-xl-4"><div class="panel metric"><span>Lotes vencidos o por vencer en 30 días</span><strong>@ViewBag.Expiring</strong><a asp-controller="Inventory" asp-action="Index">Revisar existencias →</a></div></div><div class="col-md-6 col-xl-4"><div class="panel metric"><span>Préstamos con reposición vencida</span><strong>@ViewBag.Loans</strong><a asp-controller="Inventory" asp-action="Requests">Revisar préstamos →</a></div></div>}
@if(User.IsInRole(Roles.Administrator)){<div class="col-md-6 col-xl-4"><div class="panel metric"><span>Solicitudes de bienes por autorizar</span><strong>@ViewBag.StockPending</strong><a asp-controller="Inventory" asp-action="Requests" asp-route-status="Pendiente">Autorizar y reservar →</a></div></div><div class="col-md-6 col-xl-4"><div class="panel metric"><span>Solicitudes de dinero por autorizar</span><strong>@ViewBag.FinancePending</strong><a asp-controller="Treasury" asp-action="Requests" asp-route-status="Pendiente">Revisar solicitudes →</a></div></div>}
</div>
<div class="row g-4"><div class="col-md-6"><a class="access-card panel" asp-controller="Inventory" asp-action="Create"><h2>Solicitar bienes</h2><p>Indica destino, cantidades y prioridad para su autorización.</p></a></div><div class="col-md-6"><a class="access-card panel" asp-controller="Treasury" asp-action="Create"><h2>Solicitar dinero</h2><p>Registra un gasto o anticipo y su finalidad.</p></a></div></div>
