@model DonationList
@{ ViewData["Title"] = "Donaciones"; ViewBag.Page = Model.Filter.Page; ViewBag.Total = Model.Total; }
<div class="section-heading"><h1>Donaciones</h1><a class="btn btn-primary" asp-action="Receive">Registrar recepción</a></div>
<form method="get" class="panel mb-4"><div class="row g-3 align-items-end">
<div class="col-md-3"><label for="donor">Donante, código o número</label><input id="donor" name="donor" value="@Model.Filter.Donor" class="form-control" /></div>
<div class="col-md-2"><label for="status">Estado</label><select id="status" name="status" class="form-select"><option value="">Todos</option>@foreach(var s in Enum.GetValues<DonationStatus>()) { <option value="@s" selected="@(Model.Filter.Status == s)">@s</option> }</select></div>
<div class="col-md-2"><label for="kind">Tipo</label><select id="kind" name="kind" class="form-select"><option value="">Todos</option>@foreach(var k in Enum.GetValues<DonationKind>()) { <option value="@k" selected="@(Model.Filter.Kind == k)">@k</option> }</select></div>
<div class="col-md-2"><label for="donorType">Donante</label><select id="donorType" name="donorType" class="form-select"><option value="">Todos</option><option value="Congregante" selected="@(Model.Filter.DonorType == DonorKind.Congregante)">Miembro</option><option value="Externo" selected="@(Model.Filter.DonorType == DonorKind.Externo)">Externo</option><option value="Anonimo" selected="@(Model.Filter.DonorType == DonorKind.Anonimo)">Anónimo</option></select></div>
<div class="col-md-2"><label for="origin">Origen</label><select id="origin" name="origin" class="form-select"><option value="">Todos</option><option value="Digital" selected="@(Model.Filter.Origin == DonationOrigin.Digital)">Digital (página web)</option><option value="Presencial" selected="@(Model.Filter.Origin == DonationOrigin.Presencial)">Presencial (recepción)</option></select></div>
<div class="col-md-2"><label for="from">Desde</label><input id="from" type="date" name="from" value="@Model.Filter.From?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-2"><label for="to">Hasta</label><input id="to" type="date" name="to" value="@Model.Filter.To?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-1"><button class="btn btn-primary">Filtrar</button></div>
</div><p class="mt-3 mb-0">@Model.Total registros</p></form>
<partial name="_DonationTable" model="Model.Rows" /><partial name="_Pagination" />
<p class="mt-3 fs-5">Total del resultado: <strong>S/ @Model.ApprovedMoney.ToString("N2")</strong> <small class="text-secondary fs-6">(solo dinero aprobado dentro del filtro)</small></p>
