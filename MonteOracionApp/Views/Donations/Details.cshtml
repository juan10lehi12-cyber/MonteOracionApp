@model Donation
@{ ViewData["Title"] = "Donación #" + Model.Id; }
<div class="section-heading"><div><div class="eyebrow">REGISTRO DE DONACIÓN</div><h1>Donación #@Model.Id</h1></div><span class="status status-@Model.Status">@Model.Status</span></div>
<div class="row g-4"><div class="col-lg-7"><section class="panel"><h2>@Model.DonorLabel</h2><p>Operación: @Model.OperationNumber · Fondo: @Model.FundId</p><dl class="row mt-3"><dt class="col-sm-5">Tipo</dt><dd class="col-sm-7">@Model.Kind</dd><dt class="col-sm-5">Fecha de pago / recepción</dt><dd class="col-sm-7">@Model.ReceivedOrPaidOn.ToString("dd/MM/yyyy")</dd><dt class="col-sm-5">Registrada (Lima)</dt><dd class="col-sm-7">@Model.CreatedAt.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm")</dd>
@if(Model.Kind == DonationKind.Dinero) { <dt class="col-sm-5">Monto</dt><dd class="col-sm-7">S/ @Model.Amount?.ToString("N2")</dd><dt class="col-sm-5">Medio</dt><dd class="col-sm-7">@Model.PaymentMethodName</dd> }
@if(User.IsInRole(Roles.Administrator) && Model.ExternalContact != null) { <dt class="col-sm-5">Contacto</dt><dd class="col-sm-7">@Model.ExternalContact</dd> }</dl>
<p class="small text-secondary">Código: <span class="text-break">@Model.TrackingCode.ToString("N")</span></p>
@if(Model.ReceiptStorageKey != null) { <div class="my-3"><p><strong>@(Model.Kind == DonationKind.Bienes ? "Foto del bien recibido" : "Captura del comprobante")</strong></p><a asp-action="Receipt" asp-route-id="@Model.Id" target="_blank" rel="noopener"><img src="@Url.Action("Receipt", new { id = Model.Id })" alt="@(Model.Kind == DonationKind.Bienes ? "Foto del bien donado" : "Captura del pago")" class="donation-evidence" /></a></div> }
@if(Model.Items.Count > 0) { <h3>Bienes recibidos</h3><ul>@foreach(var item in Model.Items) { <li>@item.Description · @item.Quantity.ToString("0.##") @item.Unit</li> }</ul> }
@if((User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.Warehouse)) && Model.Kind == DonationKind.Bienes && Model.Status == DonationStatus.Aprobada) {
<form method="post" asp-action="ReplaceItemPhoto" asp-route-id="@Model.Id" enctype="multipart/form-data" class="mt-3">
    <input type="hidden" name="version" value="@Convert.ToBase64String(Model.Version)" />
    <label for="photo">Reemplazar foto del bien (JPG o PNG, máximo 5 MB)</label>
    <input id="photo" name="photo" type="file" accept=".jpg,.jpeg,.png" required class="form-control mb-3" />
    <button class="btn btn-outline-primary">Guardar nueva foto</button>
</form>
}
</section><section class="panel mt-4"><h2>Historial de decisiones</h2>@if(Model.Decisions.Count == 0) { <p>Esperando la revisión del administrador.</p> }
@foreach(var decision in Model.Decisions.OrderBy(x => x.At)) { <div class="decision"><strong>@decision.Status</strong> · @decision.At.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm")<p>@decision.Reason</p>@if(User.IsInRole(Roles.Administrator)) { <small class="text-secondary">Administrador: @decision.AdministratorId</small> }</div> }</section></div>
@if((User.IsInRole(Roles.Administrator) || User.IsInRole(Roles.Treasurer) && Model.Kind == DonationKind.Dinero) && (Model.Status is DonationStatus.Pendiente or DonationStatus.Aprobada)) {
<div class="col-lg-5"><section class="panel"><h2>Revisión administrativa</h2><form method="post" asp-action="Decide" asp-route-id="@Model.Id" data-confirm="¿Registrar esta decisión? Quedará guardada en el historial."><input type="hidden" name="version" value="@Convert.ToBase64String(Model.Version)" />
@if(Model.Status == DonationStatus.Pendiente) { <p>Revisa la captura y verifica el ingreso en Yape, Plin o la cuenta bancaria antes de aprobar.</p>
@if(Model.CongregantId == null) { <div class="mb-3"><label for="congregantId">Si el donante es miembro, vincula su ficha (opcional)</label><select id="congregantId" name="congregantId" class="form-select"><option value="">Conservar donante actual</option>@if(ViewBag.Congregants is List<Congregant> members) { foreach(var member in members) { <option value="@member.Id">@member.FullName</option> } }</select><small>La vinculación se guardará al aprobar o rechazar la donación; aparecerá en su historial privado.</small></div> }
<div class="form-check my-3"><input class="form-check-input" type="checkbox" name="confirmReceived" value="true" id="confirmReceived" /><label class="form-check-label" for="confirmReceived">Confirmo que el dinero fue recibido.</label></div> }
<label for="reason">Motivo (obligatorio para rechazar o anular)</label><textarea id="reason" name="reason" maxlength="1000" class="form-control mb-3" rows="3"></textarea><div class="d-flex gap-2 flex-wrap">
@if(Model.Status == DonationStatus.Pendiente) { <button name="status" value="Aprobada" class="btn btn-primary">Aprobar</button><button name="status" value="Rechazada" class="btn btn-outline-danger">Rechazar</button> }
<button name="status" value="Anulada" class="btn btn-outline-secondary">Anular registro</button></div></form></section></div> }
</div>

