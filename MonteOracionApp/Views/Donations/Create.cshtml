@model OnlineDonationForm
@using MonteOracionApp.Modules.Publications
@{ViewData["Title"]="Registrar donación";var payments=(List<PaymentMethod>)ViewBag.Payments;var eventos=(List<Publication>)ViewBag.Events;}
<div class="section-heading"><div><div class="eyebrow">GENEROSIDAD QUE NOS UNE</div><h1>Registrar donación digital</h1><p>Realiza el pago y adjunta la captura. La administración comprobará el ingreso antes de aprobarla.</p></div></div>
@if(payments.Count==0){<div class="empty-state">Todavía no hay medios de pago activos. Acércate a la administración de la iglesia.</div>}else{
<div class="row g-4"><section class="col-lg-4"><div class="panel"><h2>Medios de pago</h2>@foreach(var p in payments){<div class="payment"><h3>@p.Name</h3><p>@p.Instructions</p>@if(p.QrStorageKey!=null){<img src="@Url.Action("Qr","Settings",new{id=p.Id})" alt="QR de @p.Name" class="payment-qr" />}</div>}</div></section>
<section class="col-lg-8"><div class="panel"><form method="post" enctype="multipart/form-data" data-confirm="¿El monto, fecha y número de operación coinciden con tu captura?"><div asp-validation-summary="All" class="text-danger"></div>
<div class="form-check mb-3"><input asp-for="Anonymous" class="form-check-input" id="chkAnonimo" /><label asp-for="Anonymous" class="form-check-label"></label><small>Solo registra monto, medio, destino, fecha, número de operación y captura.</small></div>
<div class="mb-3" id="campoDni"><label asp-for="Dni"></label><input asp-for="Dni" inputmode="numeric" maxlength="8" autocomplete="off" class="form-control" /><small>Si tu DNI no está registrado, acércate a la administración o dona de forma anónima.</small></div>
<div class="row"><div class="col-md-6 mb-3"><label asp-for="Amount"></label><input asp-for="Amount" type="number" min="0.01" max="99999.99" step="0.01" class="form-control" /></div><div class="col-md-6 mb-3"><label asp-for="PaidOn"></label><input asp-for="PaidOn" class="form-control" /></div></div>
<div class="mb-3"><label asp-for="PaymentMethodId"></label><select asp-for="PaymentMethodId" class="form-select"><option value="">Seleccionar</option>@foreach(var p in payments){<option value="@p.Id">@p.Name</option>}</select></div>
<div class="mb-3"><label asp-for="OperationNumber"></label><input asp-for="OperationNumber" maxlength="20" autocomplete="off" class="form-control" /><small>Lo encuentras en el detalle de tu pago en la app (Yape, transferencia, etc.).</small></div>
<div class="mb-3"><label>¿Para qué donas?</label><select asp-for="EventId" class="form-select"><option value="">Obra y necesidades de la iglesia</option>@foreach(var e in eventos){<option value="@e.Id">Evento: @e.Title · @e.EventAt!.Value.ToString("dd/MM/yyyy")</option>}</select><small>Por defecto tu donación apoya las necesidades generales de la iglesia. Si eliges un evento, queda dedicada a su recaudación.</small></div>
<div class="mb-3"><label asp-for="Receipt"></label><input asp-for="Receipt" type="file" accept=".jpg,.jpeg,.png" class="form-control" /></div>
<p>La captura no aprueba tu pago: la administración comprobará el ingreso antes de aprobar la donación. <a asp-controller="Home" asp-action="Privacy">Uso de tus datos</a>. Para revisar tus donaciones, acércate a la administración o llámanos.</p>
<button class="btn btn-primary">Enviar para revisión</button></form></div></section></div>}
@section Scripts{
<script>
(function(){var chk=document.getElementById('chkAnonimo'),campo=document.getElementById('campoDni');if(!chk||!campo)return;
function mostrar(){var anonimo=chk.checked;campo.classList.toggle('d-none',anonimo);var input=campo.querySelector('input');if(anonimo&&input)input.value='';input.disabled=anonimo;}
chk.addEventListener('change',mostrar);mostrar();})();
</script>
}
