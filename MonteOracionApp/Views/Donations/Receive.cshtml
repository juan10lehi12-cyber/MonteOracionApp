@model ReceivedDonationForm
@using MonteOracionApp.Modules.Inventory
@using MonteOracionApp.Modules.Treasury
@{ViewData["Title"]="Registrar recepción";var congregants=(List<Congregant>)ViewBag.Congregants;var products=(List<Product>)ViewBag.Products;}
<section class="panel form-panel"><h1>Registrar donación recibida</h1><p>Confirma el efectivo o los bienes recibidos físicamente. Cada bien ingresará al almacén con su unidad del catálogo.</p><form asp-action="Receive" method="post" enctype="multipart/form-data"><div asp-validation-summary="All" class="text-danger"></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="Kind"></label><select asp-for="Kind" class="form-select" data-donation-kind>@foreach(var k in Enum.GetValues<DonationKind>()){if(User.IsInRole(Roles.Administrator)||(k==DonationKind.Dinero?User.IsInRole(Roles.Treasurer):User.IsInRole(Roles.Warehouse))){<option value="@((int)k)">@k</option>}}</select></div><div class="col-md-6"><label asp-for="ReceivedOn"></label><input asp-for="ReceivedOn" class="form-control" /></div></div>
<div class="my-3"><label asp-for="DonorKind"></label><select asp-for="DonorKind" asp-items="Html.GetEnumSelectList<DonorKind>()" class="form-select" data-donor-kind></select></div>
<div class="mb-3" data-donor="0"><label asp-for="CongregantId"></label><select asp-for="CongregantId" class="form-select"><option value="">Seleccionar congregante</option>@foreach(var c in congregants){<option value="@c.Id">@c.FullName · @c.Dni</option>}</select></div>
<div data-donor="1"><div class="mb-3"><label asp-for="ExternalName"></label><input asp-for="ExternalName" class="form-control" /></div><div class="mb-3"><label asp-for="ExternalContact"></label><input asp-for="ExternalContact" class="form-control" /></div></div>
<div data-kind="0"><div class="mb-3"><label asp-for="Amount"></label><input asp-for="Amount" type="number" min="0.01" step="0.01" class="form-control" /></div><div class="mb-3"><label asp-for="FundId"></label><select asp-for="FundId" class="form-select">@foreach(var f in (List<Fund>)ViewBag.Funds){<option value="@f.Id">@f.Name</option>}</select></div></div>
<div data-kind="1"><h2>Bienes recibidos</h2><p><a asp-controller="Inventory" asp-action="Products" target="_blank">Abrir catálogo</a> si necesitas crear un producto; luego actualiza este formulario.</p><div data-repeat-container>
@for(var i=0;i<Model.Items.Count;i++){<div class="row g-2 mb-3 panel" data-repeat-row><div class="col-md-8"><label>Producto y unidad</label><select asp-for="Items[i].ProductId" class="form-select"><option value="">Seleccionar</option>@foreach(var p in products){<option value="@p.Id">@p.Name · @p.Unit @(p.RequiresExpiry?"(requiere vencimiento)":"")</option>}</select></div><div class="col-md-4"><label>Cantidad</label><input asp-for="Items[i].Quantity" type="number" step="0.01" min="0.01" class="form-control" /></div><div class="col-md-6"><label>Vencimiento</label><input asp-for="Items[i].ExpiresOn" type="date" class="form-control" /></div><div class="col-md-6"><label>Ubicación en almacén</label><input asp-for="Items[i].StorageLocation" maxlength="160" class="form-control" /></div></div>}
</div><button type="button" data-repeat-add class="btn btn-outline-secondary mb-3">Agregar otro bien</button><div class="mb-3"><label asp-for="ItemPhoto"></label><input asp-for="ItemPhoto" type="file" accept=".jpg,.jpeg,.png" class="form-control" /></div></div>
<div class="form-check my-4"><input asp-for="ConfirmReceived" class="form-check-input" /><label asp-for="ConfirmReceived" class="form-check-label"></label></div><button class="btn btn-primary">Confirmar recepción</button></form></section>
