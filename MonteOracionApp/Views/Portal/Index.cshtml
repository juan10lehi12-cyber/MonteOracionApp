@model MonteOracionApp.Modules.Portal.ConsultationForm
@{ ViewData["Title"] = "Consulta por DNI"; }
<section class="panel narrow"><div class="eyebrow">CONSULTA PERSONAL</div><h1>Mis donaciones</h1><p>Ingresa tu DNI registrado en la iglesia para consultar dinero, bienes y avisos de participación.</p>
<form method="post"><div asp-validation-summary="All" class="text-danger"></div><label asp-for="Dni"></label><input asp-for="Dni" class="form-control mb-3" inputmode="numeric" maxlength="8" autocomplete="off" /><button class="btn btn-primary">Consultar</button></form></section>
@if(Model.Donations != null) {
<section class="mb-4"><h2>Próximos eventos asignados</h2>
@foreach(var p in Model.Events) { <div class="alert alert-success">Participas en <strong>@p.Title</strong> · @p.EventAt?.ToString("dd/MM/yyyy HH:mm") · @p.Location <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#event-@p.Id">Ver detalles</button></div><partial name="_EventModal" model="p" /> }
@if(Model.Events.Count == 0) { <p class="text-secondary">No hay avisos de próximos eventos para mostrar.</p> }</section>
<div class="panel table-responsive"><h2>Historial de donaciones</h2><table class="table"><thead><tr><th>Fecha</th><th>Donación</th><th>Estado</th></tr></thead><tbody>
@foreach(var d in Model.Donations) { <tr><td>@d.ReceivedOrPaidOn.ToString("dd/MM/yyyy")</td><td>@if(d.Kind == DonationKind.Dinero) { <span>S/ @d.Amount?.ToString("N2")</span> } else { foreach(var i in d.Items) { <div>@i.Description · @i.Quantity.ToString("0.##") @i.Unit</div> } }</td><td>@d.Status</td></tr> }
</tbody></table>@if(Model.Donations.Count == 0) { <p>No se encontraron resultados para mostrar. Consulta con la iglesia si necesitas actualizar tu ficha.</p> }</div>
<div class="d-flex gap-2 my-3">@if(Model.Page > 1) { <form method="post"><input type="hidden" name="Dni" value="@Model.Dni" /><input type="hidden" name="Page" value="@(Model.Page-1)" /><button class="btn btn-outline-primary">Anterior</button></form> } @if(Model.Page * 15 < Model.Total) { <form method="post"><input type="hidden" name="Dni" value="@Model.Dni" /><input type="hidden" name="Page" value="@(Model.Page+1)" /><button class="btn btn-outline-primary">Siguiente</button></form> }</div>
}
