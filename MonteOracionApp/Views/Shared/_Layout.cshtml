@inject MonteOracionApp.Data.ApplicationDbContext Db
@using Microsoft.EntityFrameworkCore
@{var staff=User.IsInRole(Roles.Administrator)||User.IsInRole(Roles.Treasurer)||User.IsInRole(Roles.Warehouse);var controller=ViewContext.RouteData.Values["controller"]?.ToString();var action=ViewContext.RouteData.Values["action"]?.ToString();var workspace=staff&&controller!="Home"&&!(controller=="Donations"&&(action=="Create"||action=="Submitted"));}
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · Monte de Oración</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><a class="visually-hidden-focusable" href="#main">Ir al contenido</a><header class="site-header"><nav class="navbar navbar-expand-lg container-fluid px-4" aria-label="Principal"><a class="navbar-brand" asp-controller="Home" asp-action="Index">Monte de Oración<span>Comunidad · Comas, Lima</span></a><button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigation" aria-label="Abrir menú"><span class="navbar-toggler-icon"></span></button><div class="collapse navbar-collapse" id="navigation"><div class="d-flex flex-column flex-lg-row align-items-lg-center ms-auto"><div class="navbar-nav"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="publicaciones">Eventos</a><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="donar">Donaciones</a><a class="nav-link" asp-controller="Home" asp-action="Index" asp-fragment="contacto">Contacto</a></div><div class="d-flex gap-2 align-items-lg-center ms-lg-3 my-2 my-lg-0"><a class="btn btn-donate" asp-controller="Home" asp-action="Index" asp-fragment="donar">Donar</a>@if(staff){<a class="btn btn-outline-personal" asp-controller="Dashboard" asp-action="Index">Mi panel</a>}else{<a class="btn btn-outline-personal" asp-controller="Account" asp-action="Login">Acceso del personal</a>}<partial name="_LoginPartial" /></div></div></div></nav></header>
<div class="@(workspace?"workspace-shell":"")">
@if(workspace){<aside class="workspace-sidebar"><button class="btn btn-outline-light d-lg-none w-100" type="button" data-bs-toggle="collapse" data-bs-target="#staff-navigation" aria-controls="staff-navigation" aria-expanded="false">Módulos del personal</button><nav id="staff-navigation" class="collapse d-lg-block" aria-label="Módulos del personal"><a class="sidebar-home" asp-controller="Dashboard" asp-action="Index">Inicio del personal</a><details open><summary>Donaciones</summary><a asp-controller="Donations" asp-action="Index">Registros y verificación</a><a asp-controller="Donations" asp-action="Receive">Registrar recepción</a></details><details open><summary>Almacén</summary><a asp-controller="Inventory" asp-action="Pending">Visto bueno de entradas</a><a asp-controller="Inventory" asp-action="Index">Existencias y salidas</a><a asp-controller="Inventory" asp-action="Requests">Solicitudes y entregas</a></details>@if(User.IsInRole(Roles.Administrator)){<details open><summary>Administración</summary><a asp-controller="Publications" asp-action="Calendario">Calendario de eventos</a><a asp-controller="Publications" asp-action="Index">Eventos y publicaciones</a><a asp-controller="Publications" asp-action="Recaudacion">Recaudación</a><a asp-controller="Congregants" asp-action="Index">Miembros</a><a asp-controller="Staff" asp-action="Index">Personal y permisos</a><a asp-controller="Settings" asp-action="Index">Datos de la iglesia</a><a asp-controller="Settings" asp-action="Payments">Medios de pago</a></details>}<a class="sidebar-home" asp-controller="Reports" asp-action="Index">Reportes y PDF</a></nav></aside>}
<main class="@(workspace?"workspace-content":"container py-4")" id="main">@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}@RenderBody()</main></div>
@{var iglesia=Db.ChurchSettings.AsNoTracking().SingleOrDefault()??new MonteOracionApp.Modules.Settings.ChurchSettings();var cel=iglesia.Contact!=null?System.Text.RegularExpressions.Regex.Replace(iglesia.Contact,"[^0-9]",""):"";var whatsapp=cel.Length==9&&cel.StartsWith('9')? $"https://wa.me/51{cel}":null;}
<footer class="site-footer" id="contacto"><div class="container"><div class="row g-4 py-4">
<div class="col-md-4 footer-col"><h3>@iglesia.Name</h3><p class="preserve-lines footer-lema">@iglesia.About</p><p class="small">© @DateTime.Now.Year @iglesia.Name · Todos los derechos reservados</p><a class="small" asp-controller="Home" asp-action="Privacy">Privacidad</a></div>
<div class="col-md-4 footer-col" id="horarios"><h4>Horarios y reuniones</h4>@if(string.IsNullOrWhiteSpace(iglesia.Schedules)){<p class="small">La iglesia publicará aquí sus horarios de culto y reuniones.</p>}else{<p class="preserve-lines mb-0">@iglesia.Schedules</p>}</div>
<div class="col-md-4 footer-col"><h4>Ubicación y contacto</h4>@if(!string.IsNullOrWhiteSpace(iglesia.Address)){<p class="mb-1">📍 @iglesia.Address</p>}@if(!string.IsNullOrWhiteSpace(iglesia.Contact)){<p class="mb-1">@if(whatsapp!=null){<a href="@whatsapp" target="_blank" rel="noopener">💬 WhatsApp: @iglesia.Contact</a>}else{<span>@iglesia.Contact</span>}</p>}<a class="small footer-map" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString((iglesia.Address??"")+" Comas Lima")">Ver en Google Maps</a></div>
</div></div></footer><script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
