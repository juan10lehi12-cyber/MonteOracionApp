@if(User.Identity?.IsAuthenticated==true){<span class="nav-link">@(User.FindFirst("staff_name")?.Value??User.Identity.Name)<small class="d-block">@string.Join(" · ", User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(x=>x.Value))</small></span><a class="nav-link" asp-controller="Account" asp-action="Password">Contraseña</a><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-secondary btn-sm">Salir</button></form>}else{<a class="btn btn-outline-primary btn-sm" asp-controller="Access" asp-action="Index">Acceso del personal</a>}
