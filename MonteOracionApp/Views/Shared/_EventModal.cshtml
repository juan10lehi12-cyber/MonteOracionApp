@model Publication
<div class="modal fade" id="event-@Model.Id" tabindex="-1" aria-labelledby="event-title-@Model.Id" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title h4" id="event-title-@Model.Id">@Model.Title</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button></div><div class="modal-body">
@if(Model.ImageKey!=null){<img src="@Url.Action("Image","Publications",new{id=Model.Id})" alt="@Model.Title" class="event-modal-image mb-3" />}
@if(Model.IsCancelled){<div class="alert alert-warning">Este evento está cancelado.</div>}
@if(Model.EventAt.HasValue){<p><strong>Inicio:</strong> @Model.EventAt.Value.ToString("dd/MM/yyyy HH:mm") (Lima)</p><p><strong>Fin:</strong> @Model.EventEndsAt?.ToString("dd/MM/yyyy HH:mm")</p><p><strong>Lugar:</strong> @Model.Location</p>}
<p class="preserve-lines">@Model.Body</p></div></div></div></div>
