@model ResetPasswordForm
@{ ViewData["Title"] = "Restablecer contraseña"; }
<section class="panel narrow"><h1>Restablecer contraseña</h1><p>Usa al menos 10 caracteres. Las sesiones anteriores se cerrarán.</p><form method="post" asp-action="ResetPassword"><div asp-validation-summary="All" class="text-danger"></div><input asp-for="CongregantId" type="hidden" /><div class="mb-3"><label asp-for="Password"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /></div><button class="btn btn-primary">Restablecer</button> <a asp-action="Index" class="btn btn-link">Volver</a></form></section>

