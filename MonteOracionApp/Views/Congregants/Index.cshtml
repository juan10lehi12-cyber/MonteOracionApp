@model List<Congregant>
@{ ViewData["Title"] = "Congregantes"; }
<div class="section-heading"><h1>Congregantes</h1><a class="btn btn-primary" asp-action="Edit">Nuevo congregante</a></div>
<form method="get" class="d-flex gap-2 mb-4"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Buscar por nombre o apellido" aria-label="Buscar congregantes" /><button class="btn btn-outline-primary">Buscar</button></form>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Nombre</th><th>Contacto y acceso</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach(var c in Model) { <tr><td>@c.FullName</td><td>@c.Phone<br /><small>@(c.User?.Email ?? "Sin cuenta")</small></td><td>@(c.IsActive ? "Activo" : "Inactivo")</td><td><div class="d-flex gap-2 flex-wrap">
<a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@c.Id">Editar</a>
@if(c.UserId == null && c.IsActive) { <a class="btn btn-sm btn-outline-secondary" asp-action="CreateAccount" asp-route-id="@c.Id">Crear cuenta</a> }
@if(c.UserId != null) { <a class="btn btn-sm btn-outline-secondary" asp-action="ResetPassword" asp-route-id="@c.Id">Restablecer clave</a> }
<form method="post" asp-action="SetActive" asp-route-id="@c.Id" data-confirm="¿Cambiar el estado de este congregante y su acceso?"><input name="active" value="@((!c.IsActive).ToString())" type="hidden" /><button class="btn btn-sm btn-outline-secondary">@(c.IsActive ? "Desactivar" : "Activar")</button></form>
</div></td></tr> }
</tbody></table>@if(Model.Count == 0) { <p>No hay congregantes que coincidan con la búsqueda.</p> }</div><partial name="_Pagination" />
