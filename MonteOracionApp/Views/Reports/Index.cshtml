@{ViewData["Title"]="Reportes y PDF";var finance=User.IsInRole(Roles.Administrator)||User.IsInRole(Roles.Treasurer);var stock=User.IsInRole(Roles.Administrator)||User.IsInRole(Roles.Warehouse);}
<section class="panel form-panel"><div class="eyebrow">RENDICIÓN Y CONTROL</div><h1>Descargar reportes</h1><form asp-action="Download" method="get"><label for="kind">Reporte</label><select id="kind" name="kind" class="form-select mb-3"><option value="donaciones">Donaciones</option>@if(finance){<option value="dinero">Movimientos de dinero y saldos</option>}@if(stock){<option value="entregas">Entregas a beneficiarios y reposiciones</option><option value="inventario">Inventario actual y movimientos</option>}@if(User.IsInRole(Roles.Administrator)){<option value="auditoria">Auditoría</option>}</select>
<div class="row g-3"><div class="col-md-6"><label for="dateMode">Filtrar por</label><select id="dateMode" name="dateMode" class="form-select"><option value="dia">Día</option><option value="mes" selected>Mes</option><option value="anio">Año</option><option value="rango">Rango de fechas</option></select></div><div class="col-md-6"><label for="on">Fecha base para día, mes o año</label><input id="on" name="on" type="date" value="@ChurchTime.Today.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-6"><label for="from">Desde (para rango)</label><input id="from" name="from" type="date" class="form-control" /></div><div class="col-md-6"><label for="to">Hasta (para rango)</label><input id="to" name="to" type="date" class="form-control" /></div></div><button class="btn btn-primary mt-3">Descargar PDF</button></form></section>
@if(finance){<p class="mt-3">Las constancias individuales de cierre se descargan desde <a asp-controller="Treasury" asp-action="Closings">Cierres de caja</a>.</p>}
@if(User.IsInRole(Roles.Administrator)){<a class="btn btn-outline-primary mt-3" asp-action="Audit">Ver historial de operaciones</a>}
