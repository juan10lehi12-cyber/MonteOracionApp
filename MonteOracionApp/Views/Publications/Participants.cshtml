@model List<MonteOracionApp.Modules.Publications.EventParticipant>
@{ViewData["Title"]="Participantes";var p=(Publication)ViewBag.Event;}
<h1>Participantes · @p.Title</h1><p>La consulta por DNI muestra solo el aviso del próximo evento. Este control de asistencia es privado para administración.</p>
<form method="post" asp-action="Assign" asp-route-id="@p.Id" class="panel d-flex gap-2 mb-4"><select name="congregantId" class="form-select" aria-label="Congregante">@foreach(var c in (List<Congregant>)ViewBag.Congregants){<option value="@c.Id">@c.FullName · @(c.Dni??"Sin DNI")</option>}</select><button class="btn btn-primary">Asignar participante</button></form>
@foreach(var participant in Model){<form method="post" asp-action="Attendance" asp-route-id="@participant.Id" class="panel mb-3"><h2>@participant.Congregant.FullName · @(participant.IsActive?"Asignación activa":"Retirado")</h2><input name="version" type="hidden" value="@Convert.ToBase64String(participant.Version)" /><p>@participant.RemovalReason</p><label>Asistencia (privada)</label><select name="status" class="form-select">@foreach(var s in Enum.GetValues<MonteOracionApp.Modules.Publications.AttendanceStatus>()){<option value="@s" selected="@(participant.Attendance==s)">@s</option>}</select><label>Justificación / observación interna</label><textarea name="note" maxlength="1000" class="form-control">@participant.InternalNote</textarea><button class="btn btn-primary mt-2">Guardar asistencia</button></form>}
<a asp-action="History">Consultar historial de asistencia</a>

@foreach(var participant in Model.Where(x=>x.IsActive&&p.EventAt>ChurchTime.Now)){<form method="post" asp-action="RemoveParticipant" asp-route-id="@participant.Id" class="panel mb-3"><h3>Retirar asignación: @participant.Congregant.FullName</h3><label>Motivo</label><input name="reason" required maxlength="1000" class="form-control" /><button class="btn btn-outline-secondary mt-2">Retirar conservando historial</button></form>}
