@model Publication
@{ViewData["Title"]=Model.Id==0?"Crear publicación":"Editar publicación";}
<section class="panel form-panel"><h1>@ViewData["Title"]</h1><form method="post" asp-action="Edit" asp-route-id="@Model.Id" enctype="multipart/form-data"><div asp-validation-summary="All" class="text-danger"></div>
<div class="mb-3"><label asp-for="Kind"></label><select asp-for="Kind" asp-items="Html.GetEnumSelectList<PublicationKind>()" class="form-select"></select></div><div class="mb-3"><label asp-for="Title"></label><input asp-for="Title" class="form-control" /></div><div class="mb-3"><label asp-for="Body"></label><textarea asp-for="Body" class="form-control" rows="5"></textarea></div>
<p>Los eventos requieren imagen, fecha de inicio, fin y lugar. Los avisos solo requieren título y contenido.</p>
<div class="row g-3"><div class="col-md-6"><label asp-for="EventAt"></label><input asp-for="EventAt" type="datetime-local" class="form-control" /></div><div class="col-md-6"><label asp-for="EventEndsAt"></label><input asp-for="EventEndsAt" type="datetime-local" class="form-control" /></div></div><div class="my-3"><label asp-for="Location"></label><input asp-for="Location" class="form-control" /></div><div class="mb-3"><label for="image">Imagen JPG / PNG (máximo 5 MB; deja vacío para conservar la actual)</label><input id="image" name="image" type="file" accept=".jpg,.jpeg,.png" class="form-control" /></div>
<div class="form-check mb-4"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label"></label></div><button class="btn btn-primary">Guardar publicación</button></form></section>
