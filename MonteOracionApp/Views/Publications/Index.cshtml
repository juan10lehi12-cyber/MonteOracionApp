@model List<Publication>
@{ ViewData["Title"] = "Publicaciones"; }
<div class="section-heading"><h1>Eventos y avisos</h1><a class="btn btn-primary" asp-action="Edit">Crear publicación</a></div>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Título</th><th>Tipo</th><th>Fecha del evento</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>
@foreach(var p in Model) { <tr><td>@p.Title</td><td>@p.Kind</td><td>@p.EventAt?.ToString("dd/MM/yyyy HH:mm")</td><td>@(p.IsCancelled ? "Cancelado" : p.IsPublished ? "Publicado" : "Borrador / retirado")</td><td><div class="d-flex gap-2">
@if(!p.IsCancelled) { <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Editar</a> }
@if(p.Kind == PublicationKind.Evento) { <a class="btn btn-sm btn-outline-primary" asp-action="Participants" asp-route-id="@p.Id">Participantes y asistencia</a> }
@if(p.Kind == PublicationKind.Evento && !p.IsCancelled) { <form asp-action="Cancel" asp-route-id="@p.Id" method="post" data-confirm="¿Cancelar este evento? Se conservará su historial."><button class="btn btn-sm btn-outline-danger">Cancelar evento</button></form> }
</div></td></tr> }
</tbody></table>@if(Model.Count == 0) { <p>No hay publicaciones todavía.</p> }</div><partial name="_Pagination" />
