@model List<Publicacion>
@{
    ViewData["Title"] = "Recaudación y Bienes por Evento";
    var raised = ViewBag.Raised as Dictionary<int, decimal> ?? new();
    var goodsByEvent = ViewBag.GoodsByEvent as Dictionary<int, int> ?? new();
    var generalMoney = (decimal)(ViewBag.General ?? 0m);
    var totalEventMoney = raised.Values.Sum();
    var filtroActual = (string?)(ViewBag.Filtro) ?? "";
    var ahora = HoraIglesia.Ahora;
}

<div class="section-heading">
    <div>
        <div class="eyebrow">GESTIÓN ADMINISTRATIVA</div>
        <h1>Recaudación y Bienes por Evento</h1>
        <p class="mb-0">Seguimiento de metas, dinero recaudado y víveres acumulados en almacén para cada evento.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">← Volver a publicaciones</a>
        <a asp-action="Edit" class="btn btn-primary">➕ Nuevo evento</a>
    </div>
</div>

<!-- Resumen General arriba -->
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="panel py-2 px-3 h-100 border-start border-4 border-primary">
            <small class="text-secondary d-block">⛪ Ingreso General para la Iglesia (Aprobado)</small>
            <strong class="fs-4 text-primary">S/ @generalMoney.ToString("N2")</strong>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel py-2 px-3 h-100 border-start border-4 border-success">
            <small class="text-secondary d-block">🗓️ Total Recaudado en Eventos (Aprobado)</small>
            <strong class="fs-4 text-success">S/ @totalEventMoney.ToString("N2")</strong>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel py-2 px-3 h-100 bg-light">
            <small class="text-secondary d-block">💰 Total General + Eventos</small>
            <strong class="fs-4 text-success">S/ @((generalMoney + totalEventMoney).ToString("N2"))</strong>
        </div>
    </div>
</div>

<!-- Pestañas para separar Próximos Eventos de Eventos Finalizados -->
<div class="d-flex flex-wrap gap-2 mb-3">
    <a class="btn btn-sm @(string.IsNullOrEmpty(filtroActual) ? "btn-primary" : "btn-outline-secondary")" asp-action="Recaudacion">
        📋 Todos los eventos
    </a>
    <a class="btn btn-sm @(filtroActual.Equals("proximos", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")" asp-action="Recaudacion" asp-route-filtro="proximos">
        🗓️ Próximos eventos
    </a>
    <a class="btn btn-sm @(filtroActual.Equals("finalizados", StringComparison.OrdinalIgnoreCase) ? "btn-primary" : "btn-outline-secondary")" asp-action="Recaudacion" asp-route-filtro="finalizados">
        ✅ Eventos finalizados
    </a>
</div>

@if (!Model.Any())
{
    <div class="empty-state">No hay eventos registrados en esta categoría.</div>
}
else
{
    <div class="row g-3">
        @foreach (var p in Model)
        {
            var amount = raised.GetValueOrDefault(p.id);
            var lotesBienes = goodsByEvent.GetValueOrDefault(p.id);
            var goal = p.meta_recaudacion ?? 0;
            var pct = goal > 0 ? Math.Min(100, (int)Math.Round(amount / goal * 100)) : 0;
            var esFinalizado = !p.cancelado && (p.fecha_fin_evento ?? p.fecha_inicio_evento) < ahora;
            <div class="col-md-6">
                <div class="panel h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h2 class="h5 mb-0 fw-bold">🗓️ @p.titulo</h2>
                                <small class="text-secondary">@(p.fecha_inicio_evento?.ToString("dd/MM/yyyy HH:mm") ?? "Sin fecha")</small>
                            </div>
                            <div class="d-flex gap-1">
                                @if (p.cancelado)
                                {
                                    <span class="badge bg-danger">Cancelado</span>
                                }
                                else if (esFinalizado)
                                {
                                    <span class="badge text-bg-secondary">✅ Finalizado</span>
                                }
                                else if (p.publicado)
                                {
                                    <span class="badge bg-success">Próximo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Borrador</span>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-between small mt-3">
                            <span>Dinero recaudado: <strong class="text-success">S/ @amount.ToString("N2")</strong></span>
                            <span>Meta: <strong>@(goal > 0 ? $"S/ {goal:N2}" : "Sin meta")</strong></span>
                        </div>
                        @if (goal > 0)
                        {
                            <div class="progress mt-1" style="height:10px">
                                <div class="progress-bar bg-success" style="width:@pct%"></div>
                            </div>
                            <div class="text-end small text-secondary mt-1">@pct% alcanzado</div>
                        }
                        <div class="mt-2 pt-2 border-top small d-flex justify-content-between align-items-center">
                            <span class="text-secondary">📦 Víveres / Bienes en almacén para este evento:</span>
                            <strong class="@(lotesBienes > 0 ? "text-primary" : "text-secondary")">@lotesBienes lote(s) disponibles</strong>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap justify-content-between gap-2 mt-3 pt-3 border-top">
                        <div class="d-flex flex-wrap gap-1">
                            <a asp-controller="Donations" asp-action="Index" asp-route-destino="@p.id" class="btn btn-sm btn-outline-secondary">💰 Ver donaciones</a>
                            <a asp-controller="Inventory" asp-action="Index" asp-route-destino="@p.id" class="btn btn-sm btn-outline-secondary">📦 Ver en almacén</a>
                        </div>
                        <a asp-action="Edit" asp-route-id="@p.id" class="btn btn-sm btn-outline-primary">Editar evento</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
