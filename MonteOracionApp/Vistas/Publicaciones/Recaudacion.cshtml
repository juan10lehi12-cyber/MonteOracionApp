@model List<Publicacion>
@{
    ViewData["Title"] = "Recaudación por Evento";
    var raised = ViewBag.Raised as Dictionary<int, decimal> ?? new();
    var goodsByEvent = ViewBag.GoodsByEvent as Dictionary<int, int> ?? new();
    var totalTodos = (decimal)(ViewBag.TotalTodos ?? 0m);
    var totalProximos = (decimal)(ViewBag.TotalProximos ?? 0m);
    var totalFinalizados = (decimal)(ViewBag.TotalFinalizados ?? 0m);
    var filtroActual = (string?)(ViewBag.Filtro) ?? "";
    var queryActual = (string?)(ViewBag.Query) ?? "";
    var ahora = HoraIglesia.Ahora;
}

<div class="section-heading">
    <div>
        <div class="eyebrow">GESTIÓN ADMINISTRATIVA</div>
        <h1>Recaudación por Evento</h1>
        <p class="mb-0">Seguimiento financiero, metas y víveres recaudados exclusivamente para eventos de la iglesia.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">← Volver a publicaciones</a>
        <a asp-action="Edit" class="btn btn-primary">➕ Nuevo evento</a>
    </div>
</div>

<!-- Resumen de recaudación exclusiva de eventos -->
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="panel py-3 px-3 h-100 border-start border-4 border-primary">
            <small class="text-secondary d-block fw-semibold">💰 Total Recaudado (Todos los eventos)</small>
            <strong class="fs-4 text-primary">S/ @totalTodos.ToString("N2")</strong>
            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Acumulado histórico de todos los eventos</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel py-3 px-3 h-100 border-start border-4 border-success">
            <small class="text-secondary d-block fw-semibold">🗓️ Próximos Eventos</small>
            <strong class="fs-4 text-success">S/ @totalProximos.ToString("N2")</strong>
            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Fondos recaudados para eventos en curso / futuros</small>
        </div>
    </div>
    <div class="col-md-4">
        <div class="panel py-3 px-3 h-100 border-start border-4 border-secondary">
            <small class="text-secondary d-block fw-semibold">✅ Eventos Finalizados</small>
            <strong class="fs-4 text-secondary">S/ @totalFinalizados.ToString("N2")</strong>
            <small class="text-muted d-block mt-1" style="font-size: 0.75rem;">Total recaudado en actividades concluidas</small>
        </div>
    </div>
</div>

<!-- Barra de Filtros y Búsqueda -->
<div class="panel p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6 col-lg-5">
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">🔍</span>
                <input type="text" name="q" value="@queryActual" class="form-control border-start-0" placeholder="Buscar por título o lugar..." />
            </div>
        </div>
        <div class="col-md-4 col-lg-4">
            <select name="filtro" class="form-select" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(filtroActual))">📋 Todos los eventos</option>
                <option value="proximos" selected="@(filtroActual.Equals("proximos", StringComparison.OrdinalIgnoreCase))">🗓️ Próximos eventos</option>
                <option value="finalizados" selected="@(filtroActual.Equals("finalizados", StringComparison.OrdinalIgnoreCase))">✅ Eventos finalizados</option>
            </select>
        </div>
        <div class="col-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary">Buscar</button>
            @if (!string.IsNullOrEmpty(queryActual) || !string.IsNullOrEmpty(filtroActual))
            {
                <a asp-action="Recaudacion" class="btn btn-outline-secondary">Limpiar</a>
            }
        </div>
    </form>
</div>

@if (!Model.Any())
{
    <div class="empty-state text-center py-5">
        <span class="fs-1 d-block mb-2">📋</span>
        <h2 class="h5 fw-bold">No se encontraron eventos</h2>
        <p class="text-secondary mb-3">No hay eventos que coincidan con los filtros o la búsqueda ingresada.</p>
        @if (!string.IsNullOrEmpty(queryActual) || !string.IsNullOrEmpty(filtroActual))
        {
            <a asp-action="Recaudacion" class="btn btn-outline-primary btn-sm">Restablecer filtros</a>
        }
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var p in Model)
        {
            var amount = raised.GetValueOrDefault(p.id);
            var lotesBienes = goodsByEvent.GetValueOrDefault(p.id);
            var goal = p.meta_recaudacion ?? 0;
            var pct = goal > 0 ? Math.Min(100, (int)Math.Round(amount / goal * 100)) : 0;
            var esFinalizado = !p.cancelado && (p.fecha_fin_evento ?? p.fecha_inicio_evento) < ahora;
            <div class="col-md-6">
                <div class="panel h-100 d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h2 class="h5 mb-0 fw-bold">🗓️ @p.titulo</h2>
                                <small class="text-secondary">@(p.fecha_inicio_evento?.ToString("dd/MM/yyyy HH:mm") ?? "Sin fecha")</small>
                                @if (!string.IsNullOrWhiteSpace(p.lugar))
                                {
                                    <small class="text-secondary d-block">📍 @p.lugar</small>
                                }
                            </div>
                            <div class="d-flex gap-1">
                                @if (p.cancelado)
                                {
                                    <span class="badge bg-danger">Cancelado</span>
                                }
                                else if (esFinalizado)
                                {
                                    <span class="badge text-bg-secondary">✅ Finalizado</span>
                                }
                                else if (p.publicado)
                                {
                                    <span class="badge bg-success">Próximo</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Borrador</span>
                                }
                            </div>
                        </div>

                        <div class="d-flex justify-content-between small mt-3">
                            <span>Dinero recaudado: <strong class="text-success">S/ @amount.ToString("N2")</strong></span>
                            <span>Meta: <strong>@(goal > 0 ? $"S/ {goal:N2}" : "Sin meta")</strong></span>
                        </div>
                        @if (goal > 0)
                        {
                            <div class="progress mt-1" style="height:10px">
                                <div class="progress-bar bg-success" style="width:@pct%"></div>
                            </div>
                            <div class="text-end small text-secondary mt-1">@pct% alcanzado</div>
                        }
                        <div class="mt-2 pt-2 border-top small d-flex justify-content-between align-items-center">
                            <span class="text-secondary">📦 Víveres / Bienes en almacén:</span>
                            <strong class="@(lotesBienes > 0 ? "text-primary" : "text-secondary")">@lotesBienes lote(s) disponibles</strong>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap justify-content-between gap-2 mt-3 pt-3 border-top">
                        <div class="d-flex flex-wrap gap-1">
                            <a asp-controller="Donations" asp-action="Index" asp-route-destino="@p.id" class="btn btn-sm btn-outline-secondary">💰 Ver donaciones</a>
                            <a asp-controller="Inventory" asp-action="Index" asp-route-destino="@p.id" class="btn btn-sm btn-outline-secondary">📦 Ver en almacén</a>
                        </div>
                        <a asp-action="Edit" asp-route-id="@p.id" class="btn btn-sm btn-outline-primary">Editar evento</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
