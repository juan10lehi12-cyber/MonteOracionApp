@{
    ViewData["Title"] = "Calendario Mensual";
    var first = (DateTime)ViewBag.Month;
    var prev = (DateTime)ViewBag.Prev;
    var next = (DateTime)ViewBag.Next;
    var byDay = (Dictionary<DateTime, List<Publicacion>>)ViewBag.Events;
    int offset = ((int)first.DayOfWeek + 6) % 7;
    int days = DateTime.DaysInMonth(first.Year, first.Month);
    int semanas = (int)Math.Ceiling((offset + days) / 7.0);
    var cultura = new System.Globalization.CultureInfo("es-PE");
    var tituloMes = cultura.TextInfo.ToTitleCase(first.ToString("MMMM yyyy", cultura));
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Calendario — @tituloMes</h1>
    <div class="btn-group">
        <a asp-action="Calendario" asp-route-year="@prev.Year" asp-route-month="@prev.Month" class="btn btn-outline-secondary">&laquo; Mes anterior</a>
        <a asp-action="Calendario" asp-route-year="@next.Year" asp-route-month="@next.Month" class="btn btn-outline-secondary">Mes siguiente &raquo;</a>
    </div>
</div>

<table class="table table-bordered calendar-grid align-middle">
    <thead>
        <tr>
            @foreach (var d in new[] { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" }) { <th class="text-center small text-muted">@d</th> }
        </tr>
    </thead>
    <tbody>
        @for (int semana = 0; semana < semanas; semana++)
        {
            <tr>
                @for (int i = 0; i < 7; i++)
                {
                    int dia = semana * 7 + i - offset + 1;
                    if (dia < 1 || dia > days)
                    {
                        <td class="calendar-off"></td>
                    }
                    else
                    {
                        var fecha = new DateTime(first.Year, first.Month, dia);
                        <td>
                            <div class="fw-bold small text-muted">@dia</div>
                            @if (byDay.TryGetValue(fecha, out var lista))
                            {
                                foreach (var e in lista)
                                {
                                    <a asp-action="Edit" asp-route-id="@e.id"
                                       class="d-block calendar-event @(e.cancelado ? "cancelled" : e.publicado ? "" : "draft")">
                                        @e.titulo
                                    </a>
                                }
                            }
                        </td>
                    }
                }
            </tr>
        }
    </tbody>
</table>
