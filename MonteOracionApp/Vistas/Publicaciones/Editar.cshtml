@model Publicacion
@{ ViewData["Title"] = Model.id == 0 ? "Nueva Publicación" : "Editar Publicación"; }

<div class="section-heading">
    <div>
        <div class="eyebrow">ADMINISTRACIÓN</div>
        <h1>@ViewData["Title"]</h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Volver a publicaciones</a>
</div>

<form method="post" enctype="multipart/form-data" class="panel form-panel" style="max-width:760px">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="id" />
    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="tipo" class="form-label fw-semibold">Tipo de publicación</label>
            <select asp-for="tipo" class="form-select" id="selectTipoPublicacion">
                <option value="0">🗓️ Evento</option>
                <option value="1">📢 Aviso</option>
            </select>
        </div>
        <div class="col-md-8">
            <label asp-for="titulo" class="form-label fw-semibold">Título</label>
            <input asp-for="titulo" class="form-control" required />
        </div>
        <div class="col-12">
            <label asp-for="contenido" class="form-label fw-semibold">Contenido / Descripción</label>
            <textarea asp-for="contenido" class="form-control" rows="4" required></textarea>
        </div>

        <!-- Campos exclusivos para Eventos (se ocultan automáticamente cuando se elige Aviso) -->
        <div class="col-12" id="camposExclusivosEvento">
            <div class="p-3 rounded-3 bg-light border">
                <strong class="d-block small text-secondary text-uppercase mb-2">🗓️ Datos exclusivos del Evento</strong>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="fecha_inicio_evento" class="form-label">Inicio del Evento</label>
                        <input asp-for="fecha_inicio_evento" type="datetime-local" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="fecha_fin_evento" class="form-label">Fin del Evento</label>
                        <input asp-for="fecha_fin_evento" type="datetime-local" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="lugar" class="form-label">Lugar del Evento</label>
                        <input asp-for="lugar" class="form-control" placeholder="Ej.: Templo principal · Av. Los Ángeles 123, Comas" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="meta_recaudacion" class="form-label">Meta de Recaudación (S/ opcional)</label>
                        <input asp-for="meta_recaudacion" type="number" step="0.01" min="0" class="form-control" placeholder="Ej.: 1500.00" />
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <label class="form-label fw-semibold" id="labelImagenPublicacion">Imagen del afiche (JPG o PNG)</label>
            <input type="file" name="image" class="form-control" accept=".jpg,.jpeg,.png" />
        </div>
        <div class="col-md-6 d-flex align-items-end">
            <div class="form-check mb-2">
                <input asp-for="publicado" class="form-check-input" />
                <label asp-for="publicado" class="form-check-label fw-semibold">Publicar en el portal web</label>
            </div>
        </div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button class="btn btn-primary">Guardar publicación</button>
    </div>
</form>

@section Scripts {
    <script>
        (function () {
            const selectTipo = document.getElementById('selectTipoPublicacion');
            const bloqueEvento = document.getElementById('camposExclusivosEvento');
            const labelImagen = document.getElementById('labelImagenPublicacion');
            function actualizarCamposPorTipo() {
                const esEvento = selectTipo.value === '0' || selectTipo.value === 'Evento';
                bloqueEvento.style.display = esEvento ? '' : 'none';
                if (labelImagen) {
                    labelImagen.textContent = esEvento
                        ? 'Imagen del evento (JPG o PNG)'
                        : 'Imagen adjunta (opcional para avisos)';
                }
            }
            if (selectTipo && bloqueEvento) {
                selectTipo.addEventListener('change', actualizarCamposPorTipo);
                actualizarCamposPorTipo();
            }
        })();
    </script>
}
