@model ListaDonaciones
@{ ViewData["Title"] = "Donaciones"; ViewBag.Page = Model.filtro.pagina; ViewBag.Total = Model.total; }
<div class="section-heading"><h1>Donaciones</h1><a class="btn btn-primary" asp-action="Receive">Registrar recepción</a></div>
<form method="get" class="panel mb-4"><div class="row g-3 align-items-end">
<div class="col-md-3"><label for="donante">Donante, código o número</label><input id="donante" name="donante" value="@Model.filtro.donante" class="form-control" /></div>
<div class="col-md-2"><label for="estado">Estado</label><select id="estado" name="estado" class="form-select"><option value="">Todos</option>@foreach(var s in Enum.GetValues<EstadoDonacion>()) { <option value="@s" selected="@(Model.filtro.estado == s)">@s</option> }</select></div>
<div class="col-md-2"><label for="tipo">Tipo</label><select id="tipo" name="tipo" class="form-select"><option value="">Todos</option>@foreach(var k in Enum.GetValues<TipoDonacion>()) { <option value="@k" selected="@(Model.filtro.tipo == k)">@k</option> }</select></div>
<div class="col-md-2"><label for="tipo_donante">Donante</label><select id="tipo_donante" name="tipo_donante" class="form-select"><option value="">Todos</option><option value="Congregante" selected="@(Model.filtro.tipo_donante == TipoDonante.Congregante)">Miembro</option><option value="Externo" selected="@(Model.filtro.tipo_donante == TipoDonante.Externo)">Externo</option><option value="Anonimo" selected="@(Model.filtro.tipo_donante == TipoDonante.Anonimo)">Anónimo</option></select></div>
<div class="col-md-2"><label for="origen">Origen</label><select id="origen" name="origen" class="form-select"><option value="">Todos</option><option value="Digital" selected="@(Model.filtro.origen == OrigenDonacion.Digital)">Digital (página web)</option><option value="Presencial" selected="@(Model.filtro.origen == OrigenDonacion.Presencial)">Presencial (recepción)</option></select></div>
<div class="col-md-2"><label for="desde">Desde</label><input id="desde" type="date" name="desde" value="@Model.filtro.desde?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-2"><label for="hasta">Hasta</label><input id="hasta" type="date" name="hasta" value="@Model.filtro.hasta?.ToString("yyyy-MM-dd")" class="form-control" /></div><div class="col-md-1"><button class="btn btn-primary">Filtrar</button></div>
</div><p class="mt-3 mb-0">@Model.total registros</p></form>
<partial name="_DonationTable" model="Model.filas" /><partial name="_Pagination" />
<p class="mt-3 fs-5">Total del resultado: <strong>S/ @Model.dinero_aprobado.ToString("N2")</strong> <small class="text-secondary fs-6">(solo dinero aprobado dentro del filtro)</small></p>
