@model FormularioRecepcionDonacion
@{
    ViewData["Title"] = "Registrar donación (Mesa de Entrada)";
    var members = ((List<Congregante>)ViewBag.Congregants).Select(c => new { id = c.id, dni = c.dni ?? "", name = c.nombre_completo }).ToList();
}
<section class="panel form-panel">
    <div class="mb-3">
        <div class="eyebrow">MESA DE ENTRADA / RECEPCIÓN EXPRESS</div>
        <h1>Registrar donación presencial</h1>
        <p class="text-secondary mb-0">Documenta el efectivo o los bienes recibidos. Para bienes, solo anota lo que ves de forma sencilla; el almacenero se encargará de pesar, catalogar y organizar el inventario.</p>
    </div>

    <form asp-action="Receive" method="post" enctype="multipart/form-data" data-receive>
        <div asp-validation-summary="All" class="text-danger"></div>
        <script type="application/json" data-receive-data>@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { members }))</script>

        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <span class="form-label d-block fw-semibold">¿Qué se recibió?</span>
                <div class="form-check form-check-inline ms-1">
                    <input class="form-check-input" type="radio" asp-for="Kind" value="0" name="Kind" id="kind-0" />
                    <label class="form-check-label fw-semibold" for="kind-0">💵 Dinero en efectivo</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" asp-for="Kind" value="1" name="Kind" id="kind-1" />
                    <label class="form-check-label fw-semibold" for="kind-1">📦 Bienes físicos (Alimentos, enseres, etc.)</label>
                </div>
            </div>
            <div class="col-md-3">
                <label asp-for="ReceivedOn" class="form-label fw-semibold">Fecha de recepción</label>
                <input asp-for="ReceivedOn" class="form-control" />
            </div>
        </div>

        <div class="mb-3">
            <span class="form-label d-block fw-semibold">¿Quién dona?</span>
            <div class="form-check form-check-inline ms-1">
                <input class="form-check-input" type="radio" asp-for="DonorKind" value="0" name="DonorKind" id="donor-0" />
                <label class="form-check-label" for="donor-0">Miembro de la iglesia</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="DonorKind" value="1" name="DonorKind" id="donor-1" />
                <label class="form-check-label" for="donor-1">Persona externa</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="DonorKind" value="2" name="DonorKind" id="donor-2" />
                <label class="form-check-label" for="donor-2">Anónimo</label>
            </div>
        </div>

        <!-- Donante Miembro -->
        <div data-donor="0" class="mb-4 col-lg-7">
            <input type="hidden" asp-for="CongregantId" data-member-id />
            <label class="form-label" for="member-search">Buscar miembro por DNI o nombre</label>
            <div class="position-relative">
                <input type="text" id="member-search" class="form-control" data-member-search placeholder="Escribe DNI o nombre… p. ej. 71456 o Juana" autocomplete="off" />
                <div class="list-group position-absolute shadow" data-member-list hidden style="z-index:10;width:100%"></div>
            </div>
            <div class="mt-1" data-member-chip hidden>
                ✓ <span data-member-name class="fw-semibold"></span>
                <button type="button" class="btn btn-sm btn-link p-0" data-member-clear>cambiar</button>
            </div>
            <div class="mt-2" data-new-member hidden>
                <div class="small fw-semibold mb-1">➕ Registrar nuevo miembro</div>
                <div class="row g-2 mt-1">
                    <div class="col-md-6"><input asp-for="NewMemberName" class="form-control" placeholder="Nombre completo" autocomplete="off" /></div>
                    <div class="col-md-3"><input asp-for="NewMemberDni" class="form-control" maxlength="8" inputmode="numeric" placeholder="DNI (opcional)" autocomplete="off" /></div>
                    <div class="col-md-3"><input asp-for="NewMemberPhone" class="form-control" maxlength="9" inputmode="numeric" placeholder="Teléfono (opcional)" autocomplete="off" /></div>
                </div>
            </div>
        </div>

        <!-- Donante Externo -->
        <div data-donor="1" class="mb-4 col-lg-7">
            <div class="mb-3">
                <label asp-for="ExternalName" class="form-label">Nombre del donante externo</label>
                <input asp-for="ExternalName" class="form-control" placeholder="Ej: Familia Morales o Empresa Donante" autocomplete="off" />
            </div>
            <div class="mb-3">
                <label asp-for="ExternalContact" class="form-label">Teléfono o contacto (opcional)</label>
                <input asp-for="ExternalContact" class="form-control" placeholder="Ej: 999 888 777" autocomplete="off" />
            </div>
        </div>
        <div data-donor="2" class="mb-4"></div>

        <!-- Destino (Iglesia o Evento) -->
        <div class="mb-4 col-lg-6">
            <label asp-for="EventId" class="form-label fw-semibold">Destino declarado por el donante</label>
            <select asp-for="EventId" class="form-select">
                <option value="">⛪ General de la Iglesia (Almacén / Ayuda Social)</option>
                @if (ViewBag.Events is List<Publicacion> eventosActivos)
                {
                    @foreach (var ev in eventosActivos)
                    {
                        <option value="@ev.id">🗓️ Reservar para Evento: @ev.titulo</option>
                    }
                }
            </select>
            <small class="text-secondary d-block mt-1">Si es para un evento especial, quedará reservado y apartado para esa fecha.</small>
        </div>

        <!-- Caso 0: Dinero en efectivo -->
        <div data-kind="0" class="mb-4 col-lg-5">
            <div class="mb-3">
                <label asp-for="Amount" class="form-label fw-semibold">Monto recibido en efectivo (S/)</label>
                <div class="input-group">
                    <span class="input-group-text">S/</span>
                    <input asp-for="Amount" class="form-control" type="number" min="0.01" step="0.01" placeholder="0.00" />
                </div>
            </div>
        </div>

        <!-- Caso 1: Bienes físicos (Recepción express: solo descripción) -->
        <div data-kind="1">
            <div class="alert alert-info py-2 px-3 small mb-3">
                ℹ️ <strong>Recepción express:</strong> Solo anota lo que entrega el donante en texto libre (ej: <em>"1 saco de arroz"</em>, <em>"1 caja con fideos y conservas"</em>, <em>"Guitarra acústica con funda"</em>). En el almacén se encargarán de abrir el bulto, pesar y catalogar con la balanza y cantidades exactas.
            </div>

            <div id="goods-items" data-goods-container>
                @for (var i = 0; i < Model.Items.Count; i++)
                {
                    <div class="row g-2 mb-3 panel p-3 border goods-row" data-goods-row>
                        <input type="hidden" name="Items.Index" value="@i" />
                        <div class="col-md-10">
                            <label class="form-label fw-semibold">¿Qué entregó el donante? (Descripción del bien o bulto)</label>
                            <input asp-for="Items[i].Description" class="form-control form-control-lg" placeholder="Ej: 1 saco de arroz, 1 caja con víveres variados, 20 sillas, Guitarra..." required autocomplete="off" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="button" class="btn btn-outline-danger w-100" data-goods-remove>✕ Quitar</button>
                        </div>
                    </div>
                }
            </div>
            <button type="button" class="btn btn-outline-secondary mb-3" data-add-goods>➕ Agregar otro bien o bulto</button>
        </div>

        <button class="btn btn-primary btn-lg mt-3">Registrar donación</button>
    </form>
</section>
