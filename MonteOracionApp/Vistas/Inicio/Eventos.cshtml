@{
    ViewData["Title"] = "Eventos y Calendario";
    var church = (ConfiguracionIglesia)ViewBag.Church;
    var podio = ViewBag.Podio as Publicacion;
    var siguientes = ViewBag.Siguientes as List<Publicacion> ?? new List<Publicacion>();
    var finalizados = ViewBag.Finalizados as List<Publicacion> ?? new List<Publicacion>();
    var activeTab = (string)ViewBag.ActiveTab;
    var totalProximos = (podio != null ? 1 : 0) + siguientes.Count;
    var ahora = HoraIglesia.Ahora;
    var finDeSemana = ahora.Date.AddDays(7);
    var culturaEs = new System.Globalization.CultureInfo("es-PE");

    var first = (DateTime)(ViewBag.Month ?? new DateTime(ahora.Year, ahora.Month, 1));
    var prev = (DateTime)(ViewBag.Prev ?? first.AddMonths(-1));
    var next = (DateTime)(ViewBag.Next ?? first.AddMonths(1));
    var byDay = ViewBag.CalendarEvents as Dictionary<DateTime, List<Publicacion>> ?? new Dictionary<DateTime, List<Publicacion>>();
    var allMonthEvents = ViewBag.AllMonthEvents as List<Publicacion> ?? new List<Publicacion>();
    var avisosDelMes = ViewBag.AvisosDelMes as List<Publicacion> ?? new List<Publicacion>();
    int offset = ((int)first.DayOfWeek + 6) % 7;
    int days = DateTime.DaysInMonth(first.Year, first.Month);
    int semanas = (int)Math.Ceiling((offset + days) / 7.0);
    var tituloMes = culturaEs.TextInfo.ToTitleCase(first.ToString("MMMM yyyy", culturaEs));
    var hoy = HoraIglesia.Hoy;
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb small">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Inicio</a></li>
        <li class="breadcrumb-item">Noticias</li>
        <li class="breadcrumb-item active" aria-current="page">Eventos</li>
    </ol>
</nav>

<!-- Encabezado principal -->
<header class="section-heading text-center mx-auto mb-4" style="max-width: 780px;">
    <div class="eyebrow text-uppercase">AGENDA DE NUESTRA COMUNIDAD</div>
    <h1 class="display-5 fw-bold mb-2">Eventos y Agenda Mensual</h1>
    <p class="lead text-secondary mb-0">
        Conoce nuestras actividades programadas, consulta el calendario del mes o revisa el historial de eventos realizados.
    </p>
</header>

<!-- Selector de pestañas -->
<div class="d-flex justify-content-center mb-4">
    <div class="events-pill-tabs" role="tablist" aria-label="Filtro de eventos">
        <button type="button" class="event-pill-btn @(activeTab == "proximos" ? "is-active" : "")" data-event-tab="tab-proximos" aria-label="Ver próximos eventos">
            🗓️ Eventos <span class="badge rounded-pill bg-light text-dark ms-1">@totalProximos</span>
        </button>
        <button type="button" class="event-pill-btn @(activeTab == "calendario" ? "is-active" : "")" data-event-tab="tab-calendario" aria-label="Ver calendario mensual">
            📅 Calendario <span class="badge rounded-pill bg-light text-dark ms-1">@allMonthEvents.Count</span>
        </button>
        <button type="button" class="event-pill-btn @(activeTab == "finalizados" ? "is-active" : "")" data-event-tab="tab-finalizados" aria-label="Ver eventos finalizados">
            ✅ Finalizados <span class="badge rounded-pill bg-light text-dark ms-1">@finalizados.Count</span>
        </button>
    </div>
</div>

<!-- Contenido según la pestaña seleccionada -->
<div class="events-tab-content">

    <!-- ===================================================================
         PESTAÑA 1: PRÓXIMOS EVENTOS (LISTA & PODIO)
         =================================================================== -->
    <div class="event-tab-pane @(activeTab == "proximos" ? "is-active" : "")" id="tab-proximos">
        @if (podio == null && siguientes.Count == 0)
        {
            <div class="empty-state text-center py-5">
                <span class="fs-1 d-block mb-2">🗓️</span>
                <h2 class="h4 fw-bold">Por ahora no hay nuevos eventos programados</h2>
                <p class="text-secondary mb-3">Te esperamos en nuestros cultos dominicales y reuniones semanales.</p>
                <button type="button" class="btn btn-outline-primary btn-sm" onclick="document.querySelector('[data-event-tab=\'tab-calendario\']').click();">
                    📅 Ver calendario completo del mes
                </button>
            </div>
        }
        else
        {
            <!-- EL PODIO: Evento más próximo -->
            @if (podio != null)
            {
                var podioEsHoy = podio.fecha_inicio_evento.HasValue && podio.fecha_inicio_evento.Value.Date == ahora.Date;
                var podioEstaSemana = podio.fecha_inicio_evento.HasValue && podio.fecha_inicio_evento.Value.Date >= ahora.Date && podio.fecha_inicio_evento.Value.Date <= finDeSemana;
                var podioImg = podio.clave_imagen != null
                    ? Url.Action("Image", "Publications", new { id = podio.id })
                    : podio.titulo.Contains("Navidad", StringComparison.OrdinalIgnoreCase)
                        ? Url.Content("~/imagenes/concierto-navidad.png")
                        : Url.Content("~/imagenes/vigilia-adoracion.png");

                <div class="panel event-podium-card mb-5 p-0 overflow-hidden shadow-sm">
                    <div class="row g-0 align-items-stretch">
                        <div class="col-lg-6 event-podium-media">
                            <img src="@podioImg" alt="@podio.titulo" class="w-100 h-100 object-fit-cover" />
                            <div class="event-podium-chip">
                                @if (podioEsHoy)
                                {
                                    <span class="badge text-bg-danger fs-6 py-2 px-3"><span class="pulse-dot"></span> HOY EN VIVO</span>
                                }
                                else if (podioEstaSemana)
                                {
                                    <span class="badge text-bg-warning fs-6 py-2 px-3">★ ESTA SEMANA</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success fs-6 py-2 px-3">★ PRÓXIMO EVENTO DESTACADO</span>
                                }
                            </div>
                        </div>
                        <div class="col-lg-6 p-4 p-md-5 d-flex flex-column justify-content-center">
                            <h2 class="display-6 fw-bold mb-3">@podio.titulo</h2>

                            @if (podio.fecha_inicio_evento.HasValue)
                            {
                                <div class="d-flex flex-column gap-2 text-secondary mb-3 fs-6">
                                    <span>🗓️ <strong>Fecha:</strong> @podio.fecha_inicio_evento.Value.ToString("ddd dd MMM yyyy · HH:mm 'h'", culturaEs)</span>
                                    @if (!string.IsNullOrWhiteSpace(podio.lugar))
                                    {
                                        <span>📍 <strong>Lugar:</strong> @podio.lugar</span>
                                    }
                                </div>
                            }

                            <p class="text-secondary mb-4 line-clamp-3">@podio.contenido</p>

                            <div class="d-flex flex-wrap gap-2 pt-2">
                                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#featured-event-spotlight">
                                    Ver afiche y detalles
                                </button>
                                <a class="btn btn-outline-success fw-semibold" asp-controller="Donations" asp-action="Create" asp-route-evento="@podio.id">
                                    💚 Ofrendar / Apoyar
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Siguientes eventos en cuadrícula de tarjetas -->
            @if (siguientes.Count > 0)
            {
                <div class="section-heading mb-3">
                    <h3 class="h4 fw-bold mb-0">Otros eventos programados</h3>
                </div>
                <div class="row g-4 mb-4">
                    @foreach (var ev in siguientes)
                    {
                        var evImg = ev.clave_imagen != null
                            ? Url.Action("Image", "Publications", new { id = ev.id })
                            : ev.titulo.Contains("Navidad", StringComparison.OrdinalIgnoreCase)
                                ? Url.Content("~/imagenes/concierto-navidad.png")
                                : Url.Content("~/imagenes/vigilia-adoracion.png");

                        <div class="col-md-6 col-xl-4">
                            <article class="panel event-card h-100 d-flex flex-column">
                                <div class="event-cover-wrap">
                                    <img class="event-cover" src="@evImg" alt="@ev.titulo" loading="lazy" />
                                </div>
                                <h4 class="h5 fw-bold mt-2 mb-1">@ev.titulo</h4>
                                @if (ev.fecha_inicio_evento.HasValue)
                                {
                                    <p class="small text-secondary mb-2">
                                        🗓️ @ev.fecha_inicio_evento.Value.ToString("ddd dd MMM yyyy · HH:mm 'h'", culturaEs)
                                    </p>
                                }
                                <p class="text-secondary small line-clamp-2 mb-3">@ev.contenido</p>
                                <div class="mt-auto pt-2 d-flex gap-2">
                                    <button type="button" class="btn btn-outline-primary btn-sm flex-grow-1" data-bs-toggle="modal" data-bs-target="#event-@ev.id">
                                        Ver detalles
                                    </button>
                                    <a class="btn btn-outline-success btn-sm" asp-controller="Donations" asp-action="Create" asp-route-evento="@ev.id">
                                        Ofrendar
                                    </a>
                                </div>
                            </article>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <!-- ===================================================================
         PESTAÑA 2: CALENDARIO MENSUAL PÚBLICO + AVISOS LATERALES
         =================================================================== -->
    <div class="event-tab-pane @(activeTab == "calendario" ? "is-active" : "")" id="tab-calendario">
        <div class="row g-4">
            <!-- Columna Izquierda (8 cols): Calendario Mensual Interactivo -->
            <div class="col-lg-8">
                <div class="panel p-3 p-md-4 mb-4">
                    <!-- Cabecera del mes y navegación -->
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 pb-3 border-bottom">
                        <div>
                            <div class="eyebrow">AGENDA MENSUAL</div>
                            <h2 class="h3 fw-bold mb-0 text-primary">@tituloMes</h2>
                        </div>
                        <div class="btn-group">
                            <a asp-action="Eventos" asp-route-tab="calendario" asp-route-year="@prev.Year" asp-route-month="@prev.Month" class="btn btn-outline-secondary btn-sm">
                                &laquo; @culturaEs.TextInfo.ToTitleCase(prev.ToString("MMM", culturaEs))
                            </a>
                            <a asp-action="Eventos" asp-route-tab="calendario" class="btn btn-outline-primary btn-sm">
                                Mes actual
                            </a>
                            <a asp-action="Eventos" asp-route-tab="calendario" asp-route-year="@next.Year" asp-route-month="@next.Month" class="btn btn-outline-secondary btn-sm">
                                @culturaEs.TextInfo.ToTitleCase(next.ToString("MMM", culturaEs)) &raquo;
                            </a>
                        </div>
                    </div>

                    <!-- Cuadrícula interactiva -->
                    <div class="table-responsive">
                        <table class="table table-bordered calendar-grid align-middle mb-0">
                            <thead>
                                <tr>
                                    @foreach (var d in new[] { "Lun", "Mar", "Mié", "Jue", "Vie", "Sáb", "Dom" })
                                    {
                                        <th class="text-center small text-secondary bg-light" style="width: 14.28%;">@d</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (int semana = 0; semana < semanas; semana++)
                                {
                                    <tr>
                                        @for (int i = 0; i < 7; i++)
                                        {
                                            int dia = semana * 7 + i - offset + 1;
                                            if (dia < 1 || dia > days)
                                            {
                                                <td class="calendar-off"></td>
                                            }
                                            else
                                            {
                                                var fecha = new DateTime(first.Year, first.Month, dia);
                                                var esHoy = fecha == hoy;
                                                <td class="@(esHoy ? "bg-warning-subtle" : "")" style="min-height: 95px; vertical-align: top; padding: .35rem;">
                                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                                        <span class="fw-bold small @(esHoy ? "text-primary" : "text-secondary")">@dia</span>
                                                        @if (esHoy)
                                                        {
                                                            <span class="badge text-bg-primary" style="font-size:.65rem;">Hoy</span>
                                                        }
                                                    </div>
                                                    @if (byDay.TryGetValue(fecha, out var lista))
                                                    {
                                                        foreach (var e in lista)
                                                        {
                                                            <button type="button"
                                                                    class="calendar-event btn btn-link p-1 text-start d-block w-100 text-decoration-none mb-1 border-0"
                                                                    style="background: #28594318; color: #183d2c; border-radius: 6px; font-size: 0.75rem;"
                                                                    data-bs-toggle="modal"
                                                                    data-bs-target="#event-@e.id"
                                                                    title="Clic para ver detalles de @e.titulo">
                                                                @if (e.fecha_inicio_evento.HasValue)
                                                                {
                                                                    <strong class="d-block text-primary" style="font-size: 0.7rem;">🕒 @e.fecha_inicio_evento.Value.ToString("HH:mm")</strong>
                                                                }
                                                                <span class="d-inline-block text-truncate w-100 fw-semibold">@e.titulo</span>
                                                            </button>
                                                        }
                                                    }
                                                </td>
                                            }
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="mt-3 small text-secondary d-flex flex-wrap align-items-center gap-3">
                        <span>💡 <em>Haz clic sobre cualquier evento en el calendario para ver sus detalles completos, afiche, mapa y ofrendas.</em></span>
                    </div>
                </div>
            </div>

            <!-- Columna Derecha (4 cols): Avisos importantes del mes + Cultos habituales -->
            <div class="col-lg-4">
                <!-- Panel de Avisos y Comunicados -->
                <aside class="panel p-4 mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h3 class="h5 fw-bold mb-0">📢 Avisos de la Iglesia</h3>
                        <a asp-controller="Home" asp-action="Avisos" class="small text-decoration-none">Ver todos →</a>
                    </div>

                    @if (avisosDelMes.Count == 0)
                    {
                        <p class="small text-secondary mb-0">No hay avisos recientes publicados por la administración.</p>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">
                            @foreach (var av in avisosDelMes)
                            {
                                <article class="p-3 bg-light rounded-3 border">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <span class="badge text-bg-primary" style="font-size: 0.7rem;">Aviso</span>
                                        <small class="text-secondary" style="font-size: 0.72rem;">@av.fecha_creacion.ToString("dd MMM", culturaEs)</small>
                                    </div>
                                    <h4 class="h6 fw-bold mb-1">@av.titulo</h4>
                                    <p class="small text-secondary mb-2 line-clamp-2">@av.contenido</p>
                                    <button type="button" class="btn btn-outline-primary btn-sm py-0 px-2" style="font-size: 0.75rem;" data-bs-toggle="modal" data-bs-target="#event-@av.id">
                                        Leer completo →
                                    </button>
                                </article>
                            }
                        </div>
                    }
                </aside>

                <!-- Recordatorio de cultos habituales -->
                <div class="panel p-4 border-start border-4 border-primary">
                    <h3 class="h6 fw-bold mb-2">🕒 Cultos Habituales</h3>
                    @if (!string.IsNullOrWhiteSpace(church.horarios))
                    {
                        <p class="small text-secondary preserve-lines mb-3">@church.horarios</p>
                    }
                    else
                    {
                        <p class="small text-secondary mb-3">Cultos dominicales: 9:00 a.m. y 6:00 p.m.</p>
                    }
                    <a class="btn btn-outline-primary btn-sm w-100" asp-controller="Home" asp-action="Horarios">
                        🗺️ Ver mapa y cómo llegar
                    </a>
                </div>
            </div>
        </div>

        @foreach (var ev in allMonthEvents)
        {
            <partial name="_EventModal" model="ev" />
        }
        @foreach (var av in avisosDelMes)
        {
            <partial name="_EventModal" model="av" />
        }
    </div>

    <!-- ===================================================================
         PESTAÑA 3: EVENTOS FINALIZADOS
         =================================================================== -->
    <div class="event-tab-pane @(activeTab == "finalizados" ? "is-active" : "")" id="tab-finalizados">
        @if (finalizados.Count == 0)
        {
            <div class="empty-state text-center py-5">
                <span class="fs-1 d-block mb-2">✅</span>
                <h2 class="h4 fw-bold">No hay eventos finalizados en el registro</h2>
                <p class="text-secondary mb-0">Los eventos pasados aparecerán en esta sección como memoria de nuestra comunidad.</p>
            </div>
        }
        else
        {
            <div class="row g-4 mb-4">
                @foreach (var fin in finalizados)
                {
                    var finImg = fin.clave_imagen != null
                        ? Url.Action("Image", "Publications", new { id = fin.id })
                        : fin.titulo.Contains("Navidad", StringComparison.OrdinalIgnoreCase)
                            ? Url.Content("~/imagenes/concierto-navidad.png")
                            : Url.Content("~/imagenes/hero-comunidad.png");

                    <div class="col-md-6 col-xl-4">
                        <article class="panel event-card h-100 d-flex flex-column">
                            <div class="event-cover-wrap">
                                <img class="event-cover" src="@finImg" alt="@fin.titulo" loading="lazy" />
                                <span class="badge text-bg-secondary position-absolute bottom-0 start-0 m-3 px-3 py-1">
                                    ✅ Realizado
                                </span>
                            </div>
                            <h3 class="h5 fw-bold mt-2 mb-1">@fin.titulo</h3>
                            @if (fin.fecha_inicio_evento.HasValue)
                            {
                                <p class="small text-secondary mb-2">
                                    🗓️ Realizado el @fin.fecha_inicio_evento.Value.ToString("ddd dd MMM yyyy", culturaEs)
                                </p>
                            }
                            <p class="text-secondary small line-clamp-2 mb-3">@fin.contenido</p>
                            <div class="mt-auto pt-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm w-100" data-bs-toggle="modal" data-bs-target="#event-@fin.id">
                                    Ver resumen y afiche
                                </button>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>

</div>

<!-- Renderizar Modales de Eventos Destacados -->
@if (podio != null)
{
    var imgPodioModal = podio.clave_imagen != null
        ? Url.Action("Image", "Publications", new { id = podio.id })
        : podio.titulo.Contains("Navidad", StringComparison.OrdinalIgnoreCase)
            ? Url.Content("~/imagenes/concierto-navidad.png")
            : Url.Content("~/imagenes/vigilia-adoracion.png");

    <div class="modal fade" id="featured-event-spotlight" tabindex="-1" aria-labelledby="spotlight-title" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content spotlight-modal-content">
                <div class="spotlight-modal-banner">
                    <img src="@imgPodioModal" alt="@podio.titulo" />
                    <div class="spotlight-modal-overlay">
                        <span class="spotlight-pill"><span class="pulse-dot"></span> PRÓXIMO EVENTO DESTACADO</span>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                </div>
                <div class="modal-body p-4">
                    <h2 class="h3 fw-bold mb-2" id="spotlight-title">@podio.titulo</h2>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        @if (podio.fecha_inicio_evento.HasValue)
                        {
                            <span class="badge text-bg-primary-subtle text-primary-emphasis py-2 px-3">
                                🗓️ @podio.fecha_inicio_evento.Value.ToString("dddd dd 'de' MMMM yyyy · HH:mm 'h'", culturaEs)
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(podio.lugar))
                        {
                            <span class="badge text-bg-light border text-dark py-2 px-3">
                                📍 @podio.lugar
                            </span>
                        }
                    </div>
                    <p class="text-secondary preserve-lines mb-4">@podio.contenido</p>
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 border-top">
                        @if (!string.IsNullOrWhiteSpace(podio.lugar))
                        {
                            <a class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(podio.lugar)">
                                🗺️ Ver ubicación en Google Maps
                            </a>
                        }
                        else
                        {
                            <span></span>
                        }
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-success fw-semibold" asp-controller="Donations" asp-action="Create" asp-route-evento="@podio.id">
                                💚 Ofrendar / Apoyar este evento
                            </a>
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <partial name="_EventModal" model="podio" />
}
@foreach (var ev in siguientes)
{
    <partial name="_EventModal" model="ev" />
}
@foreach (var fin in finalizados)
{
    <partial name="_EventModal" model="fin" />
}
