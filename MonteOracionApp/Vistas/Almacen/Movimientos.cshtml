@model List<MovimientoAlmacen>
@{
    ViewData["Title"] = "Historial de entradas y salidas";
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    ViewBag.Page = (int)ViewBag.Page;
    var names = (Dictionary<string, string>)ViewBag.Names;
    var eventosFiltro = ViewBag.EventosFiltro as List<Publicacion> ?? [];
    var saldosPorMov = ViewBag.SaldosPorMovimiento as Dictionary<long, decimal> ?? new();
    var tipoActual = (string?)(ViewBag.Tipo) ?? "";
    var destinoActual = (string?)(ViewBag.Destino) ?? "";
    var total = (int)(ViewBag.Total ?? 0);
    var conteoEntradas = (int)(ViewBag.ConteoEntradas ?? 0);
    var conteoSalidas = (int)(ViewBag.ConteoSalidas ?? 0);
    var conteoAjustes = (int)(ViewBag.ConteoAjustes ?? 0);
    var conteoTotal = conteoEntradas + conteoSalidas + conteoAjustes;
}

<div class="section-heading">
    <div>
        <div class="eyebrow">GESTIÓN DE ALMACÉN</div>
        <h1>Entradas y salidas (Kardex)</h1>
        <p class="mb-0">Registro auditable de todos los ingresos confirmados, salidas despachadas y balances históricos de stock.</p>
    </div>
    <div class="d-flex gap-2">
        <a class="btn btn-primary" asp-action="Exit">📤 Registrar salida</a>
        <a class="btn btn-outline-secondary" asp-action="Index">← Ver existencias</a>
    </div>
</div>

<!-- 1. TARJETAS INTERACTIVAS POR TIPO DE MOVIMIENTO -->
<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <a href="@Url.Action("Movements", new { search = ViewBag.Search, destino = destinoActual, tipo = "" })"
           class="panel p-3 d-block text-decoration-none h-100 @(string.IsNullOrEmpty(tipoActual) ? "border-dark border-2 shadow-sm bg-light" : "border text-reset")">
            <small class="text-secondary d-block fw-semibold">📋 Todos los movimientos</small>
            <strong class="fs-4 text-dark">@conteoTotal</strong>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="@Url.Action("Movements", new { search = ViewBag.Search, destino = destinoActual, tipo = "entrada" })"
           class="panel p-3 d-block text-decoration-none h-100 border-start border-4 border-success @(tipoActual == "entrada" ? "bg-success-subtle shadow-sm" : "text-reset")">
            <small class="text-secondary d-block fw-semibold">📥 Entradas (+)</small>
            <strong class="fs-4 text-success">@conteoEntradas</strong> <small class="text-secondary">ingresos</small>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="@Url.Action("Movements", new { search = ViewBag.Search, destino = destinoActual, tipo = "salida" })"
           class="panel p-3 d-block text-decoration-none h-100 border-start border-4 border-danger @(tipoActual == "salida" ? "bg-danger-subtle shadow-sm" : "text-reset")">
            <small class="text-secondary d-block fw-semibold">📤 Salidas (−)</small>
            <strong class="fs-4 text-danger">@conteoSalidas</strong> <small class="text-secondary">despachos</small>
        </a>
    </div>
    <div class="col-6 col-md-3">
        <a href="@Url.Action("Movements", new { search = ViewBag.Search, destino = destinoActual, tipo = "ajuste" })"
           class="panel p-3 d-block text-decoration-none h-100 border-start border-4 border-info @(tipoActual == "ajuste" ? "bg-info-subtle shadow-sm" : "text-reset")">
            <small class="text-secondary d-block fw-semibold">⚖️ Ajustes de cuadre</small>
            <strong class="fs-4 text-info-emphasis">@conteoAjustes</strong> <small class="text-secondary">correcciones</small>
        </a>
    </div>
</div>

<!-- 2. ZONA DE FILTROS Y BÚSQUEDA (Sin redundancias) -->
<div class="panel p-3 mb-4">
    <!-- Pestañas de cuenta principales -->
    <div class="d-flex flex-wrap gap-2 align-items-center mb-3 pb-3 border-bottom">
        <span class="small fw-bold text-uppercase text-secondary me-1">Cuenta:</span>
        <a href="@Url.Action("Movements", new { search = ViewBag.Search, tipo = tipoActual, destino = "" })"
           class="btn btn-sm fw-semibold border"
           style="@(string.IsNullOrEmpty(destinoActual) ? "background-color: #1e293b; color: #fff; border-color: #1e293b;" : "background-color: #fff; color: #475569; border-color: #e2e8f0;")">
            📋 Todas
        </a>
        <a href="@Url.Action("Movements", new { search = ViewBag.Search, tipo = tipoActual, destino = "general" })"
           class="btn btn-sm fw-semibold border"
           style="@(destinoActual == "general" ? "background-color: #1e293b; color: #fff; border-color: #1e293b;" : "background-color: #fff; color: #475569; border-color: #e2e8f0;")">
            🏛️ Almacén General de la Iglesia
        </a>
        <a href="@Url.Action("Movements", new { search = ViewBag.Search, tipo = tipoActual, destino = "eventos" })"
           class="btn btn-sm fw-semibold border"
           style="@(destinoActual == "eventos" || int.TryParse(destinoActual, out _) ? "background-color: #1e293b; color: #fff; border-color: #1e293b;" : "background-color: #fff; color: #475569; border-color: #e2e8f0;")">
            📅 Bienes de Eventos
        </a>
    </div>

    <!-- Barra de búsqueda limpia (sin dropdown duplicado) -->
    <form method="get" class="d-flex flex-wrap align-items-center gap-2">
        <input type="hidden" name="tipo" value="@tipoActual" />
        <input type="hidden" name="destino" value="@destinoActual" />
        <div class="flex-grow-1" style="min-width: 260px;">
            <input id="search" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="🔍 Buscar por producto (ej. Arroz), categoría, motivo, evento o responsable..." />
        </div>
        <div class="d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm px-3 fw-semibold">Filtrar</button>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string) || !string.IsNullOrEmpty(tipoActual) || !string.IsNullOrEmpty(destinoActual))
            {
                <a class="btn btn-outline-secondary btn-sm" asp-action="Movements">Limpiar filtros</a>
            }
        </div>
    </form>
</div>

<!-- 3. TABLA DE KARDEX CON SALDO RESULTANTE -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
    <span class="small text-secondary">
        Mostrando <strong>@Model.Count</strong> de <strong>@total</strong> movimientos registrados
    </span>
    <span class="small text-secondary">
        Moneda / Unidades oficiales de almacén
    </span>
</div>

<div class="panel table-responsive p-0 border">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light" style="background-color: #f8fafc; border-bottom: 2px solid #e2e8f0;">
            <tr style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: #64748b;">
                <th class="ps-3 py-3" style="width: 140px;">Fecha y hora</th>
                <th class="py-3" style="width: 120px;">Operación</th>
                <th class="py-3" style="min-width: 200px;">Producto / Categoría</th>
                <th class="py-3">Cuenta · Motivo · Responsable</th>
                <th class="pe-3 py-3 text-end" style="width: 175px;">Cantidad y Saldo</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                var esEntrada = m.cantidad > 0;
                var esAjuste = m.destino == MonteOracionApp.Servicios.ServicioAlmacen.DestinoAjuste;
                var evLote = m.lote?.donacion_bien?.donacion?.evento;
                var responsable = names.TryGetValue(m.id_usuario, out var n) ? n : "Personal de almacén";
                var saldo = saldosPorMov.TryGetValue(m.id, out var s) ? s : (decimal?)null;

                <tr class="align-middle border-bottom">
                    <!-- 1. Fecha y hora -->
                    <td class="ps-3 py-3 text-nowrap">
                        <div class="fw-semibold text-dark">@m.fecha_hora.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy")</div>
                        <small class="text-secondary" style="font-size: 0.78rem;">@m.fecha_hora.ToOffset(TimeSpan.FromHours(-5)).ToString("HH:mm") hrs</small>
                    </td>

                    <!-- 2. Operación (Badge pastel suave con bordes redondeados) -->
                    <td>
                        @if (esAjuste)
                        {
                            <span class="badge border" style="background-color: #fef3c7; color: #92400e; border-color: #fde68a !important; font-weight: 600; font-size: 0.8rem; padding: 4px 10px; border-radius: 6px;">
                                ⚖️ Ajuste
                            </span>
                        }
                        else if (esEntrada)
                        {
                            <span class="badge border" style="background-color: #dcfce7; color: #15803d; border-color: #bbf7d0 !important; font-weight: 600; font-size: 0.8rem; padding: 4px 10px; border-radius: 6px;">
                                ↓ Entrada
                            </span>
                        }
                        else
                        {
                            <span class="badge border" style="background-color: #fee2e2; color: #991b1b; border-color: #fecaca !important; font-weight: 600; font-size: 0.8rem; padding: 4px 10px; border-radius: 6px;">
                                ↑ Salida
                            </span>
                        }
                    </td>

                    <!-- 3. Producto y Categoría (Texto plano gris sutil, sin cápsula) -->
                    <td>
                        <div class="fw-bold text-dark fs-6">@m.lote?.producto.nombre</div>
                        <div class="small" style="color: #64748b; font-size: 0.8rem;">@m.lote?.producto.categoria</div>
                    </td>

                    <!-- 4. Cuenta, Detalle y Responsable (Jerarquía de dos líneas) -->
                    <td>
                        <div class="fw-semibold" style="font-size: 0.88rem;">
                            @if (evLote != null)
                            {
                                <span class="text-success-emphasis">📅 Evento: @evLote.titulo</span>
                            }
                            else
                            {
                                <span class="text-primary">🏛️ Almacén General de la Iglesia</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(m.destino) && !esAjuste && m.destino != "Almacén General de la Iglesia" && !(evLote != null && m.destino.StartsWith("Evento:")))
                            {
                                <span class="text-dark small fw-normal ms-1">→ @m.destino</span>
                            }
                        </div>
                        <small class="text-secondary d-flex flex-wrap align-items-center gap-1 mt-1" style="font-size: 0.8rem;">
                            <span>@m.motivo</span>
                            <span class="text-muted">•</span>
                            <span class="d-inline-flex align-items-center gap-1 text-dark">
                                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" fill="currentColor" class="bi bi-person text-secondary" viewBox="0 0 16 16">
                                    <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6m2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0m4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4m-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10s-3.516.68-4.168 1.332c-.678.678-.83 1.418-.832 1.664z"/>
                                </svg>
                                @responsable
                            </span>
                        </small>
                    </td>

                    <!-- 5. Cantidad y Saldo Resultante -->
                    <td class="text-end pe-3 text-nowrap" style="width: 175px;">
                        <div style="font-variant-numeric: tabular-nums;">
                            <span class="fw-bold fs-5 @(esEntrada ? "text-success" : "text-danger")">
                                @m.cantidad.ToString("+0.##;-0.##;0", inv)
                            </span>
                            <small class="text-secondary fw-semibold ms-1">@m.lote?.producto.unidad</small>
                        </div>
                        @if (saldo.HasValue)
                        {
                            <div class="small" style="font-size: 0.75rem; color: #64748b; font-variant-numeric: tabular-nums;">
                                Saldo: <strong>@saldo.Value.ToString("0.##", inv)</strong> @m.lote?.producto.unidad
                            </div>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Count == 0)
    {
        <div class="text-center py-5">
            <p class="text-secondary mb-0">No se encontraron movimientos registrados con los filtros seleccionados.</p>
        </div>
    }
</div>

<partial name="_Paginacion" />
