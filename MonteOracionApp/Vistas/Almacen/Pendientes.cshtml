@model List<Lote>
@{ ViewData["Title"] = "Visto bueno de entradas"; var names = (Dictionary<string, string>)ViewBag.Names; }
<div class="section-heading"><div><div class="eyebrow">ALMACÉN</div><h1>Visto bueno de entradas</h1><p>Confirma que los bienes donados están en el almacén e indica dónde quedaron guardados. Puedes confirmar una entrada que tú mismo registraste.</p></div></div>
@if (Model.Count == 0)
{
    <div class="empty-state">No hay entradas pendientes de visto bueno.</div>
}
else
{
    <div class="panel table-responsive"><table class="table"><thead><tr><th>Producto</th><th>Cantidad</th><th>Recibió</th><th>Ubicación y visto bueno</th></tr></thead><tbody>
    @foreach (var l in Model)
    {
        <tr>
            <td><strong>@l.producto.nombre</strong><br /><small>@l.producto.unidad</small></td>
            <td>@l.cantidad_actual.ToString("0.##")</td>
            <td>@(l.id_usuario_pendiente != null && names.TryGetValue(l.id_usuario_pendiente, out var n) ? n : "-")<br /><small class="text-secondary">@l.fecha_pendiente?.ToOffset(TimeSpan.FromHours(-5)).ToString("dd/MM/yyyy HH:mm")</small></td>
            <td><form method="post" asp-action="Confirm" asp-route-id="@l.id" class="d-flex gap-2 align-items-stretch" style="min-width:300px"><input name="commandId" type="hidden" value="@Guid.NewGuid()" /><input name="location" maxlength="160" required class="form-control form-control-sm" placeholder="Ubicación (estante, zona…)" /><button class="btn btn-success btn-sm text-nowrap">Dar visto bueno</button></form></td>
        </tr>
    }
    </tbody></table></div>
}
<a class="btn btn-link" asp-action="Index">Ver existencias</a>
