@model FormularioSalidaAlmacen
@{ ViewData["Title"] = "Registrar salida"; var lots = (List<Lote>)ViewBag.Lots; }
<section class="panel form-panel">
<div class="eyebrow">ALMACÉN</div><h1>Registrar salida</h1>
<p>Para entregar bienes (por ejemplo a un evento de la iglesia). Al guardar, la cantidad se descuenta sola del almacén.</p>
<form method="post"><div asp-validation-summary="All" class="text-danger"></div>
<input asp-for="id_comando" type="hidden" />
<div class="row g-3 mb-3"><div class="col-md-6"><label asp-for="destino" class="form-label"></label><input asp-for="destino" class="form-control" placeholder="Ej.: Almuerzo de aniversario" autocomplete="off" /></div><div class="col-md-6"><label asp-for="detalle" class="form-label"></label><input asp-for="detalle" class="form-control" autocomplete="off" /></div></div>
<p class="mb-1 fw-semibold">¿Qué sale? Llena solo las filas que necesites.</p>
<div class="panel table-responsive mb-3"><table class="table align-middle mb-0"><thead><tr><th>Producto · ubicación (disponible)</th><th style="width:160px">Cantidad</th></tr></thead><tbody>
@for (var i = 0; i < Model.lineas.Count; i++)
{
    <tr><td><select asp-for="lineas[i].id_lote" class="form-select"><option value="0">—</option>@foreach (var l in lots){<option value="@l.id" selected="@(Model.lineas[i].id_lote == l.id)">@l.producto.nombre · @(string.IsNullOrWhiteSpace(l.ubicacion) ? "sin ubicación" : l.ubicacion) (@l.cantidad_actual.ToString("0.##") @l.producto.unidad)</option>}</select></td><td><input asp-for="lineas[i].cantidad" class="form-control" type="number" min="0.01" step="0.01" /></td></tr>
}
</tbody></table></div>
@if (lots.Count == 0) { <p class="text-secondary">No hay existencias disponibles con visto bueno.</p> }
<button class="btn btn-primary">Registrar salida</button> <a class="btn btn-link" asp-action="Index">Cancelar</a>
</form></section>
