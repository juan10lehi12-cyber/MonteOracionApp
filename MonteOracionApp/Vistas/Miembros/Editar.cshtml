@model Congregante
@{ ViewData["Title"] = Model.id == 0 ? "Nuevo Miembro" : "Editar Miembro"; }

<div class="section-heading">
    <div>
        <div class="eyebrow">ADMINISTRACIÓN</div>
        <h1>@ViewData["Title"]</h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Volver a miembros</a>
</div>

<form method="post" class="panel form-panel" style="max-width:650px">
    <div asp-validation-summary="All" class="text-danger mb-2"></div>
    <input type="hidden" asp-for="id" />
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label fw-semibold">Nombres</label><input asp-for="nombres" class="form-control" required /></div>
        <div class="col-md-6"><label class="form-label fw-semibold">Apellidos</label><input asp-for="apellidos" class="form-control" required /></div>
        <div class="col-md-4"><label class="form-label fw-semibold">DNI (8 dígitos) <span class="text-danger">*</span></label><input asp-for="dni" class="form-control" maxlength="8" required /></div>
        <div class="col-md-4"><label class="form-label fw-semibold">Teléfono</label><input asp-for="telefono" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label fw-semibold">Fecha de nacimiento</label><input asp-for="fecha_nacimiento" type="date" asp-format="{0:yyyy-MM-dd}" class="form-control" /></div>
        <div class="col-12"><label class="form-label fw-semibold">Dirección</label><input asp-for="direccion" class="form-control" /></div>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button class="btn btn-primary">Guardar miembro</button>
    </div>
</form>
