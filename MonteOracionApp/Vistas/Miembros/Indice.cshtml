@model List<Congregante>
@{
    ViewData["Title"] = "Miembros de la Iglesia";
    ViewBag.Page = (int)(ViewBag.Page ?? 1);
    var total = (int)(ViewBag.Total ?? 0);
}

<div class="section-heading">
    <div>
        <div class="eyebrow">ADMINISTRACIÓN</div>
        <h1>Miembros de la Iglesia</h1>
    </div>
    <a asp-action="Edit" class="btn btn-primary">➕ Nuevo miembro</a>
</div>

<form method="get" class="panel p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-5">
            <label for="search" class="small fw-semibold">Buscar por DNI, nombres o apellidos</label>
            <input id="search" name="search" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Ej. 71234567, María, Quispe..." />
        </div>
        <div class="col-md-3">
            <label for="active" class="small fw-semibold">Estado</label>
            <select id="active" name="active" class="form-select form-select-sm">
                <option value="">Todos</option>
                <option value="true" selected="@(ViewBag.Active == true)">Activos</option>
                <option value="false" selected="@(ViewBag.Active == false)">Inactivos</option>
            </select>
        </div>
        <div class="col-md-4 d-flex gap-1">
            <button type="submit" class="btn btn-primary btn-sm px-3">Filtrar</button>
            <a class="btn btn-outline-secondary btn-sm" asp-action="Index">Limpiar</a>
        </div>
    </div>
</form>

<div class="d-flex justify-content-between align-items-center mb-2">
    <span class="small text-secondary">Mostrando <strong>@Model.Count</strong> de <strong>@total</strong> miembros en total</span>
</div>

<div class="panel table-responsive">
    <table class="table align-middle mb-0">
        <thead>
            <tr>
                <th>Miembro</th>
                <th>DNI</th>
                <th>Cumpleaños</th>
                <th>Teléfono</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td class="fw-semibold">
                        @c.nombre_completo
                        @if (!string.IsNullOrEmpty(c.direccion)) { <div class="small text-secondary fw-normal">@c.direccion</div> }
                    </td>
                    <td>@(c.dni ?? "—")</td>
                    <td>@(c.fecha_nacimiento?.ToString("dd/MM") ?? "—")</td>
                    <td>@(c.telefono ?? "—")</td>
                    <td><span class="badge @(c.activo ? "bg-success" : "bg-secondary")">@(c.activo ? "Activo" : "Inactivo")</span></td>
                    <td class="text-end">
                        <a asp-controller="Donations" asp-action="Index" asp-route-donante="@c.nombre_completo" class="btn btn-sm btn-outline-secondary" title="Ver donaciones de este miembro">Donaciones</a>
                        <a asp-action="Edit" asp-route-id="@c.id" class="btn btn-sm btn-outline-primary">Editar</a>
                        @if (User.IsInRole(Roles.Administrador))
                        {
                            <form asp-action="SetActive" asp-route-id="@c.id" method="post" class="d-inline">
                                <input type="hidden" name="active" value="@(c.activo ? "false" : "true")" />
                                <button class="btn btn-sm btn-outline-secondary">@(c.activo ? "Desactivar" : "Reactivar")</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Count == 0)
    {
        <p class="text-secondary mb-0">No se encontraron miembros con este filtro.</p>
    }
</div>
<partial name="_Pagination" />
