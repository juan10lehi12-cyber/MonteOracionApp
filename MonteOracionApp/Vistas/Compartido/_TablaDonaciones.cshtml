@model List<Donacion>
<div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Registro</th><th>Fecha de pago / recepción</th>@if(User.Identity?.IsAuthenticated == true) { <th>Donante</th><th>Origen</th> }<th>Tipo / monto</th><th>Estado</th><th></th></tr></thead><tbody>
@foreach(var d in Model) { <tr><td>#@d.id</td><td>@d.fecha_recepcion_pago.ToString("dd/MM/yyyy")</td>@if(User.Identity?.IsAuthenticated == true) { <td>@d.etiqueta_donante</td><td><span class="badge @(d.digital ? "text-bg-info" : "text-bg-secondary")">@(d.digital ? "Digital" : "Presencial")</span></td> }<td>@(d.tipo == TipoDonacion.Dinero ? "S/ " + d.monto?.ToString("N2") : "Bienes")</td><td><span class="status status-@d.estado">@d.estado</span></td><td><a asp-controller="Donations" asp-action="Details" asp-route-id="@d.id">Ver detalle →</a></td></tr> }
</tbody></table>@if(Model.Count == 0) { <p class="text-secondary">Todavía no hay donaciones para mostrar.</p> }</div>
