@model List<Donacion>
<div class="panel table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Registro</th>
                <th>Fecha</th>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <th>Donante</th>
                    <th>Origen</th>
                }
                <th>Destino</th>
                <th>Tipo / monto</th>
                <th>Estado</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var d in Model)
            {
                <tr>
                    <td>#@d.id</td>
                    <td>@d.fecha_recepcion_pago.ToString("dd/MM/yyyy")</td>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <td>@d.etiqueta_donante</td>
                        <td><span class="badge @(d.digital ? "text-bg-info" : "text-bg-secondary")">@(d.digital ? "Digital" : "Presencial")</span></td>
                    }
                    <td>
                        @if (d.id_evento == null)
                        {
                            <span class="badge text-bg-light border text-dark">⛪ General (Iglesia)</span>
                        }
                        else
                        {
                            <span class="badge text-bg-primary-subtle text-primary-emphasis">🗓️ @(d.evento?.titulo ?? $"Evento #{d.id_evento}")</span>
                        }
                    </td>
                    <td>
                        @if (d.tipo == TipoDonacion.Dinero)
                        {
                            <span>S/ @d.monto?.ToString("N2")</span>
                            @if (!string.IsNullOrWhiteSpace(d.nombre_medio_pago))
                            {
                                <span class="badge text-bg-light border text-secondary ms-1">@d.nombre_medio_pago</span>
                            }
                        }
                        else
                        {
                            <span>Bienes</span>
                        }
                    </td>
                    <td><span class="status status-@d.estado">@d.estado</span></td>
                    <td><a asp-controller="Donations" asp-action="Details" asp-route-id="@d.id">Ver detalle →</a></td>
                </tr>
            }
        </tbody>
    </table>
    @if (Model.Count == 0)
    {
        <p class="text-secondary mb-0">Todavía no hay donaciones para mostrar con estos filtros.</p>
    }
</div>
