@inject MonteOracionApp.Datos.ContextoBaseDatos Db
@using Microsoft.EntityFrameworkCore
@{
    var staff = User.IsInRole(Roles.Administrador) || User.IsInRole(Roles.Personal);
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var workspace = staff && controller != "Home" && !(controller == "Donations" && (action == "Create" || action == "Submitted"));
    var iglesia = Db.ConfiguracionesIglesia.AsNoTracking().SingleOrDefault() ?? new ConfiguracionIglesia();
    var whatsapp = iglesia.ObtenerUrlWhatsApp();
}
<!DOCTYPE html><html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewData["Title"] · Monte de Oración</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><a class="visually-hidden-focusable" href="#main">Ir al contenido</a>
@if (!staff)
{
    <div class="inst-topbar">
        <div class="container-fluid px-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex flex-wrap align-items-center gap-3 small">
                @if (!string.IsNullOrWhiteSpace(iglesia.direccion))
                {
                    <span>📍 @iglesia.direccion</span>
                }
                <span class="d-none d-md-inline">🕒 Cultos dominicales: 9:00 a.m. y 6:00 p.m.</span>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-3 small">
                @if (!string.IsNullOrWhiteSpace(iglesia.contacto))
                {
                    <span>📞 @iglesia.contacto</span>
                }
                @if (whatsapp != null)
                {
                    <a class="inst-topbar-link" href="@whatsapp" target="_blank" rel="noopener">💬 WhatsApp Pastoral</a>
                }
                <a class="inst-topbar-link" asp-controller="Home" asp-action="Horarios">🗺️ Cómo llegar</a>
            </div>
        </div>
    </div>
}
<header class="site-header sticky-top">
    <nav class="navbar navbar-expand-lg container-fluid px-4" aria-label="Principal">
        @if (staff)
        {
            <!-- Modo Personal / Administrador: Barra limpia enfocada en el trabajo interno -->
            <a class="navbar-brand" asp-controller="Dashboard" asp-action="Index">
                Monte de Oración<span>Panel de Gestión Interna</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigation" aria-label="Abrir menú">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navigation">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-lg-end w-100 gap-2 my-2 my-lg-0">
                    @if (!workspace)
                    {
                        <a class="btn btn-outline-personal btn-sm" asp-controller="Dashboard" asp-action="Index">Ir al panel del personal</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Home" asp-action="Index" title="Ver portal público de la iglesia">🌐 Ver web pública</a>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        }
        else
        {
            <!-- Modo Visitante Público: Menú institucional completo -->
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                Monte de Oración<span>Comunidad · Comas, Lima</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigation" aria-label="Abrir menú">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navigation">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center w-100">
                    <ul class="navbar-nav mx-auto gap-lg-2 my-2 my-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>

                        <!-- Dropdown: La Iglesia -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">La Iglesia</a>
                            <ul class="dropdown-menu dropdown-menu-inst">
                                <li><h6 class="dropdown-header">Nuestra comunidad</h6></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="QuienesSomos"><span class="dropdown-ico">⛪</span>Quiénes somos</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Ministerios"><span class="dropdown-ico">🙌</span>Áreas de Servicio</a></li>
                            </ul>
                        </li>

                        <!-- Dropdown: Noticias (Eventos y Avisos) -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Noticias</a>
                            <ul class="dropdown-menu dropdown-menu-inst">
                                <li><h6 class="dropdown-header">Actualidad comunitaria</h6></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Eventos"><span class="dropdown-ico">🗓️</span>Eventos</a></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Avisos"><span class="dropdown-ico">📢</span>Avisos</a></li>
                            </ul>
                        </li>

                        <!-- Enlace directo: Horarios y Mapa -->
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Horarios">Horarios y Mapa</a>
                        </li>

                        <!-- Botón unificado de Ofrendas y Donaciones -->
                        <li class="nav-item ms-lg-2 d-flex align-items-center">
                            <a class="btn btn-donate" asp-controller="Donations" asp-action="Create">Donar</a>
                        </li>
                    </ul>
                    <!-- Extremo derecho exclusivo para el acceso interno -->
                    <div class="d-flex align-items-lg-center my-2 my-lg-0">
                        <a class="btn btn-outline-personal" asp-controller="Account" asp-action="Login">Acceso del personal</a>
                    </div>
                </div>
            </div>
        }
    </nav>
</header>
<div class="@(workspace?"workspace-shell":"")">
@if(workspace){<aside class="workspace-sidebar"><button class="btn btn-outline-light d-lg-none w-100" type="button" data-bs-toggle="collapse" data-bs-target="#staff-navigation" aria-controls="staff-navigation" aria-expanded="false">Módulos del personal</button><nav id="staff-navigation" class="collapse d-lg-block" aria-label="Módulos del personal"><a class="sidebar-home" asp-controller="Dashboard" asp-action="Index">Inicio del personal</a><details open><summary>Gestión de Donaciones</summary><a asp-controller="Donations" asp-action="Index">Verificar donaciones</a><a asp-controller="Donations" asp-action="Receive">Registrar donación</a></details><details open><summary>Gestión de Almacén</summary><a asp-controller="Inventory" asp-action="Pending">Visto bueno de entradas</a><a asp-controller="Inventory" asp-action="Index">Existencias</a><a asp-controller="Inventory" asp-action="Exit">Registrar salida</a><a asp-controller="Inventory" asp-action="Movements">Entradas y salidas</a></details>@if(User.IsInRole(Roles.Administrador)){<details open><summary>Gestión Administrativa</summary><a asp-controller="Publications" asp-action="Index">Eventos y publicaciones</a><a asp-controller="Publications" asp-action="Calendario">Calendario de eventos</a><a asp-controller="Publications" asp-action="Recaudacion">Recaudación por evento</a><a asp-controller="Congregants" asp-action="Index">Miembros</a><a asp-controller="Staff" asp-action="Index">Personal y permisos</a><a asp-controller="Settings" asp-action="Index">Datos de la iglesia</a><a asp-controller="Settings" asp-action="Payments">Medios de pago</a></details>}</nav></aside>}
<main class="@(workspace?"workspace-content":"container py-4")" id="main">@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}@RenderBody()</main></div>
@if (!workspace)
{
    <footer class="site-footer" id="contacto"><div class="container"><div class="row g-4 py-4">
    <div class="col-md-4 footer-col"><h3>@iglesia.nombre</h3><p class="preserve-lines footer-lema">@iglesia.informacion</p><p class="small">© @DateTime.Now.Year @iglesia.nombre · Todos los derechos reservados</p><a class="small" asp-controller="Home" asp-action="Privacy">Privacidad</a></div>
    <div class="col-md-4 footer-col" id="horarios"><h4>Horarios y reuniones</h4>@if(string.IsNullOrWhiteSpace(iglesia.horarios)){<p class="small">La iglesia publicará aquí sus horarios de culto y reuniones.</p>}else{<p class="preserve-lines mb-0">@iglesia.horarios</p>}</div>
    <div class="col-md-4 footer-col"><h4>Ubicación y contacto</h4>@if(!string.IsNullOrWhiteSpace(iglesia.direccion)){<p class="mb-1">📍 @iglesia.direccion</p>}@if(!string.IsNullOrWhiteSpace(iglesia.contacto)){<p class="mb-1">@if(whatsapp!=null){<a href="@whatsapp" target="_blank" rel="noopener">💬 WhatsApp: @iglesia.contacto</a>}else{<span>@iglesia.contacto</span>}</p>}<a class="small footer-map" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString((iglesia.direccion??"")+" Comas Lima")">Ver en Google Maps</a></div>
    </div></div></footer>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
