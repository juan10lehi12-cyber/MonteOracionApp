@model FormularioPersonal
@{ ViewData["Title"] = string.IsNullOrEmpty(Model.id_usuario) ? "Nuevo Usuario" : "Editar Usuario"; }

<div class="section-heading">
    <div>
        <div class="eyebrow">GESTIÓN ADMINISTRATIVA</div>
        <h1>@ViewData["Title"]</h1>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Volver a personal</a>
</div>

<form method="post" class="panel form-panel" style="max-width:620px">
    <div asp-validation-summary="All" class="text-danger mb-2"></div>
    <input type="hidden" asp-for="id_usuario" />
    <div class="mb-3">
        <label class="form-label fw-semibold">Nombre completo</label>
        <input asp-for="nombre_completo" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label fw-semibold">Cargo / Área de apoyo</label>
        <input asp-for="cargo" class="form-control" placeholder="Ej.: Coordinador de Almacén, Tesorería..." />
    </div>
    <div class="mb-3">
        <label class="form-label fw-semibold">Correo electrónico (usuario de acceso)</label>
        <input asp-for="correo" type="email" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label fw-semibold">Contraseña @(string.IsNullOrEmpty(Model.id_usuario) ? "(obligatoria)" : "(dejar en blanco para mantener la actual)")</label>
        <input asp-for="clave" type="password" class="form-control" autocomplete="new-password" />
    </div>
    <div class="mb-3">
        <label class="form-label fw-semibold d-block">Roles asignados</label>
        <div class="form-check form-check-inline">
            <input asp-for="administrador" class="form-check-input" />
            <label asp-for="administrador" class="form-check-label">Administrador (acceso total)</label>
        </div>
        <div class="form-check form-check-inline">
            <input asp-for="personal" class="form-check-input" />
            <label asp-for="personal" class="form-check-label">Personal (donaciones y almacén)</label>
        </div>
    </div>
    <div class="form-check">
        <input asp-for="activo" class="form-check-input" />
        <label asp-for="activo" class="form-check-label fw-semibold">Cuenta activa (permitir inicio de sesión)</label>
    </div>
    <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        <button class="btn btn-primary">Guardar usuario</button>
    </div>
</form>
