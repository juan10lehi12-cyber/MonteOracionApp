@model List<PerfilPersonal>
@{
    ViewData["Title"] = "Personal y Accesos";
    var roles = (Dictionary<string, IList<string>>)ViewBag.UserRoles;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Personal y Roles del Sistema</h1>
    <a asp-action="Edit" class="btn btn-primary">Nuevo usuario</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Nombre</th><th>Cargo</th><th>Correo</th><th>Roles</th><th>Estado</th><th class="text-end">Acción</th></tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="fw-semibold">@p.nombre_completo</td>
                        <td>@p.cargo</td>
                        <td>@p.usuario.Email</td>
                        <td>
                            @foreach (var r in roles.GetValueOrDefault(p.id_usuario) ?? Array.Empty<string>())
                            { <span class="badge bg-primary me-1">@r</span> }
                        </td>
                        <td><span class="badge @(p.activo ? "bg-success" : "bg-danger")">@(p.activo ? "Activo" : "Bloqueado")</span></td>
                        <td class="text-end"><a asp-action="Edit" asp-route-id="@p.id_usuario" class="btn btn-sm btn-outline-primary">Editar</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
